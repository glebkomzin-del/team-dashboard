+    paragraphs=[]
+    for item in proposal['observations']:
+        evidence_ids=list(dict.fromkeys(units_by_span[(span['start'],span['end'],span['quote'])]
+                                     for span in item['source_spans']))
+        relation=item.get('relation_review')
