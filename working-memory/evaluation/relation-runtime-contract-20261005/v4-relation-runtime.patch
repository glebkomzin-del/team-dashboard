+"""Conservative, source-bound relation stage for new meeting candidates only.
+
+Model relation labels are proposals, never independent proof of a withdrawal.
+"""
+import hashlib
+import json
+import copy
+
+from memory import ValidationError, fingerprint
+
+RELATIONS = ('none', 'confirmed', 'independent', 'expressly_withdrawn', 'replaced', 'unclear')
+ID_FIELDS = ('earlier_ids', 'later_ids', 'object_ids', 'action_ids',
+             'prerequisite_ids', 'replacement_ids', 'competing_ids')
+FIELDS = {'candidate_id', 'relation', *ID_FIELDS}
+REVIEW_RELATIONS = {'expressly_withdrawn', 'replaced', 'unclear'}
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True,
+                                     separators=(',', ':')).encode()).hexdigest()
+
+
+def candidates(meeting, observations, originals):
+    """Only current-source new action candidates; no historical work update."""
+    source_hash = fingerprint(meeting['raw_transcript'])
+    if (meeting.get('content_hash') != source_hash or type(meeting.get('expected_revision')) is not int
+            or not isinstance(meeting.get('id'), str) or not meeting['id']):
+        raise ValidationError('Relation source identity or revision unavailable')
+    selected = []
+    for index, item in enumerate(observations):
+        if item.get('kind') != 'commitment' or item.get('update', 'none') != 'none' or item.get('update_target'):
+            continue
+        original_ids = [unit_id for unit_id, unit in originals.items()
+                        if any(unit['start'] == span.get('start') and unit['end'] == span.get('end')
+                               and unit['text'] == span.get('quote') for span in item.get('source_spans', []))]
+        if not original_ids:
+            raise ValidationError('New candidate lacks exact original span binding')
+        scope = {'job_id': meeting['id'], 'source_id': meeting['source_id'], 'content_hash': source_hash,
+                 'expected_revision': meeting['expected_revision'], 'index': index,
+                 'source_ids': original_ids, 'source_candidate': item}
+        selected.append({'index': index, 'candidate_id': digest(scope),
+                         'source_ids': original_ids, 'source_hash': source_hash})
+    return selected
+
+
+def schema(originals, selected):
+    ids = sorted(originals)
+    id_array = {'type': 'array', 'uniqueItems': True,
+                'items': {'type': 'string', 'enum': ids}}
+    properties = {'candidate_id': {'type': 'string', 'enum': [x['candidate_id'] for x in selected]},
+                  'relation': {'type': 'string', 'enum': list(RELATIONS)}}
+    properties.update({name: id_array for name in ID_FIELDS})
+    return {'type': 'object', 'additionalProperties': False, 'required': ['relations'],
+            'properties': {'relations': {'type': 'array', 'minItems': len(selected),
+                                        'maxItems': len(selected),
+                                        'items': {'type': 'object', 'additionalProperties': False,
+                                                  'required': sorted(FIELDS), 'properties': properties}}}}
+
+
+def prompt(originals, selected):
+    """No extraction summary, old work/gate, free final statement, or prior model prose."""
+    exposed = [{'candidate_id': row['candidate_id'], 'source_ids': row['source_ids']}
+               for row in selected]
+    original_texts = {identifier: unit['text'] for identifier, unit in originals.items()}
+    return ('Prüfe ausschließlich Beziehungen zwischen Aussagen dieses Originals. '
+            'Jede Relation ist ein prüfbedürftiger Vorschlag, keine Arbeitsfreigabe. '
+            'Gib jeden candidate_id genau einmal zurück; verwende nur Original-IDs. '
+            'none heißt keine spätere Aussage zu dieser Handlung erkannt. '
+            'Bestätigte eigenständige Zusagen nicht mit einer anderen Handlung vermischen. '
+            'Keine Zusammenfassung, freien Zitate, endgültigen Aussagen, Owner, Aufgaben oder Bedingungen ausgeben.\n'
+            'Kandidaten (IDs aus bereits ausgewählten Originalstellen):\n'
+            + json.dumps(exposed, ensure_ascii=False, sort_keys=True)
+            + '\nOriginalstellen:\n' + json.dumps(original_texts, ensure_ascii=False, sort_keys=True))
+
+
+def inspect(value, originals, selected):
+    """Checks structure/identity, not semantic truth. Invalid means every candidate review."""
+    try:
+        if not isinstance(value, dict) or set(value) != {'relations'} or not isinstance(value['relations'], list):
+            raise ValueError('invalid relation envelope')
+        rows = value['relations']
+        expected = {item['candidate_id']: item for item in selected}
+        if len(rows) != len(expected) or any(not isinstance(row, dict) for row in rows):
+            raise ValueError('relation coverage changed')
+        if {row.get('candidate_id') for row in rows} != set(expected):
+            raise ValueError('relation candidate identity changed')
+        checked = {}
+        for row in rows:
+            if set(row) != FIELDS or row['relation'] not in RELATIONS:
+                raise ValueError('free or invalid relation field')
+            identifiers = {}
+            for name in ID_FIELDS:
+                ids = row[name]
+                if (not isinstance(ids, list) or any(not isinstance(i, str) or i not in originals for i in ids)
+                        or len(ids) != len(set(ids))):
+                    raise ValueError('unknown or repeated original ID')
+                identifiers[name] = ids
+            earlier, later = identifiers['earlier_ids'], identifiers['later_ids']
+            if not earlier or not set(expected[row['candidate_id']]['source_ids']) <= set(earlier):
+                raise ValueError('new candidate source proof missing')
+            relation = row['relation']
+            if relation == 'none':
+                if later or any(identifiers[name] for name in ID_FIELDS if name != 'earlier_ids'):
+                    raise ValueError('none relation has extra evidence')
+            else:
+                if not later or max(originals[i]['start'] for i in earlier) >= min(originals[i]['start'] for i in later):
+                    raise ValueError('later original evidence missing or reversed')
+                if relation in ('confirmed', 'independent', 'expressly_withdrawn', 'replaced'):
+                    if not identifiers['object_ids'] or not identifiers['action_ids'] or not identifiers['prerequisite_ids']:
+                        raise ValueError('positive object/action/prerequisite evidence missing')
+                    if not set(identifiers['object_ids']) & set(earlier) or not set(identifiers['object_ids']) & set(later):
+                        raise ValueError('object evidence must cite both sides')
+                if relation == 'replaced' and not identifiers['replacement_ids']:
+                    raise ValueError('replacement evidence missing')
+                if relation == 'unclear' and not identifiers['competing_ids']:
+                    raise ValueError('ambiguity referents missing')
+            checked[row['candidate_id']] = row
+        return checked, None
+    except (AttributeError, KeyError, TypeError, ValueError) as error:
+        return {}, str(error)
+
+
+def apply_review(observations, selected, checked, error, originals):
+    """No source, owner, task or condition rewrite. Review blocks only affected work."""
+    result = copy.deepcopy(observations)
+    for candidate in selected:
+        row = checked.get(candidate['candidate_id'])
+        if error or row is None or row['relation'] in REVIEW_RELATIONS:
+            item = result[candidate['index']]
+            item['required_review'] = True
+            item['change_score'] = min(item.get('change_score', 1), 1)
+            item['confidence_reason'] = 'Beziehung zwischen Originalstellen fachlich zu prüfen.'
+            item['action_uncertainty'] = 'Mögliche Änderung der neuen Zusage im selben Original; Originalstellen fachlich prüfen.'
+            ids = candidate['source_ids'] if row is None else list(dict.fromkeys(row['earlier_ids'] + row['later_ids']))
+            item['relation_review'] = {'status': 'pending', 'relation': None if row is None else row['relation'],
+                                       'candidate_id': candidate['candidate_id'],
+                                       'source_hash': candidate['source_hash'], 'evidence_ids': ids}
+            existing = {(span['start'], span['end']) for span in item['source_spans']}
+            for identifier in ids:
+                unit = originals[identifier]
+                if (unit['start'], unit['end']) not in existing:
+                    item['source_spans'].append({'start': unit['start'], 'end': unit['end'], 'quote': unit['text']})
+                if unit['text'] not in item['quotes']:
+                    item['quotes'].append(unit['text'])
+        # none/confirmed/independent are inert: the existing gate alone decides.
+    return result
