+def classify_result(response, usage_micro_usd, model, *, historical_actual=None):
+    """Keep billing, terminal delivery, final answer, and semantics distinct."""
+    status = response.get('terminal_status')
+    status = status if status in ('completed', 'incomplete', 'failed') else None
+    returned = response.get('returned_service_tier')
+    known_cost = (usage_micro_usd(response, model) if returned == 'default' else None)
+    cost_source = 'final_usage_standard_estimate' if known_cost is not None else 'unknown'
+    if historical_actual is not None:
+        if type(historical_actual) is not int or historical_actual < 0:
+            raise ValueError('Invalid historical receipt cost')
+        if known_cost is not None and known_cost != historical_actual:
+            raise ValueError('Historical receipt and final usage disagree')
+        known_cost = historical_actual
+        cost_source = 'historical_receipt_known'
+    complete = (status == 'completed' and returned == 'default'
+                and response.get('stop_reason') == 'end_turn'
+                and isinstance(response.get('content'), list) and bool(response['content']))
+    if complete and known_cost is not None:
+        state = 'known_complete'
+    elif status == 'incomplete':
+        state = 'known_incomplete'
+    elif status == 'failed':
+        state = 'known_failed'
+    else:
+        state = 'outcome_or_usage_unknown'
+    return {'actual_micro_usd': known_cost, 'cost_knowledge': cost_source,
+            'transport_outcome': 'provider_terminal_received' if status else 'unknown_after_transport',
+            'terminal_status': status,
+            'incomplete_reason': response.get('incomplete_reason'),
+            'provider_error_code': response.get('provider_error_code'),
+            'requested_service_tier': 'default', 'returned_service_tier': returned,
+            'completeness': 'complete_final_answer' if complete else 'no_final_answer',
+            'semantic_assessment': 'PENDING_OFFLINE_REVIEW' if complete else 'NOT_POSSIBLE_NO_FINAL_ANSWER',
+            'state': state}
 
 
