def claude_model(models, role):
    """Quelle: Claude sub-agents#supported-models; Konzept-Modellnamen → Alias.

    Annahme: Die Konzept-Anzeigenamen benennen eine Modellfamilie, keine API-ID.
    Explizite Kennungen bleiben unverändert; es wird keine Version erfunden.
    """
    value = models[role]["claude"]
    require(isinstance(value, str) and value.strip() and "\n" not in value,
            "Ungültiges Claude-Modell für " + role)
    match = re.fullmatch(r"(Opus|Sonnet|Haiku)(?:\s+\d+(?:\.\d+)*)?", value, re.I)
    return match[1].lower() if match else value


def merge_settings(existing, added):
    """Listen vereinigen, fremde Schlüssel erhalten; Kit-Skalare setzen.

    Quelle: Auftrag Phase 2 C. Kein Ersetzen ganzer hooks/permissions-Blöcke.
    """
    if isinstance(existing, dict) and isinstance(added, dict):
        result = dict(existing)
        for key, value in added.items():
            result[key] = merge_settings(result[key], value) if key in result else value
        return result
    if isinstance(existing, list) and isinstance(added, list):
        return existing + [x for x in added if x not in existing]
    return added


def markdown_parts(text):
    """Nur das einfache Frontmatter unserer Claude-Vorlagen lesen (kein YAML-Parser)."""
    header, body = text.split("---\n", 2)[1:]
    fields = dict(line.split(": ", 1) for line in header.splitlines() if ": " in line)
    return fields, body


def codex_skill(kit, role):
    fields, body = markdown_parts(read(Path(kit) / "claude/commands" / (role + ".md")))
    # Bewusst ein Vorspann statt verwinkelter Ersetzungen; Ablauf bleibt dieselbe Quelle.
    intro = ("Unter Codex gilt für den folgenden gemeinsamen Ablauf: Setze die Rolle mit `/" + role + "`. "
             "Agent-Werkzeug/holen bedeutet Codex-Agenten nach Name holen: Grobplan `planner`, "
             "Feinplan `planner_fein` (bei Eskalation `planner`), normale Tasks `worker`, "
             "mechanische Tasks `worker_mechanisch`, Prüfung `reviewer`. "
             "Alle Modellwahl-Anweisungen im gemeinsamen Text entfallen: Die Agentendateien legen "
             "das Modell aus der Spalte codex in .gov/models.json fest; beim Holen kein Modell wählen. "
             "`gov models apply` aktualisiert auch die Codex-Agentendateien. "
             "Annahme: Die Rollenmarke steht wörtlich am Anfang des Nutzerprompts.\n\n")
    if role == "migrate":
        intro = ("Unter Codex startet `/migrate` (auch `$migrate`) diese einmalige Session. "
                 "Verwende die Agentendateien leser (gpt-6.1-terra), schreiber (gpt-6.1-sol), "
                 "pruefer (gpt-6-astra); beim Holen kein Modell überschreiben. "
                 "Session: GPT-6 Astra. Vor finish sind keine Kit-Gates aktiv.\n\n")
    return ("---\nname: " + role + "\ndescription: " + json.dumps(fields["description"], ensure_ascii=False) +
            "\n---\n" + intro + body)


def codex_agent(kit, role, models):
    source_role = {"planner_fein": "planner", "worker_mechanisch": "worker"}.get(role, role)
    fields, body = markdown_parts(read(Path(kit) / "claude/agents" / (source_role + ".md")))
    model = models[role]["codex"]
    require(isinstance(model, str) and model.strip() and "\n" not in model,
            "Ungültiges Codex-Modell für " + role)
    # Belegte Kennungen aus Auftrag/ENTWURF 7; explizite Kennungen bleiben erhalten.
    model = {"GPT-6 Astra": "gpt-6-astra", "GPT-6.1 Sol": "gpt-6.1-sol",
             "GPT-6.1 Terra": "gpt-6.1-terra"}.get(model, model)
    body = ("Unter Codex legt diese Agentendatei das Modell fest; die Modellwahl beim Holen "
            "im gemeinsamen Text entfällt.\n\n" + body)
    if source_role in ('worker', 'planner'):
        body = 'Ponytail full gilt immer; lade den Skill, ohne Sicherheit, Datenintegrität oder Pflichttests zu kürzen.\n' + body
    if source_role in ('worker', 'planner', 'reviewer', 'leser'):
        body = 'Graphify gilt vor dem Lesen unbekannten Codes und bei Strukturfragen; lade den Skill, prüfe am Code, Vollaufbau mit KI nur auf ausdrücklichen Wunsch.\n' + body
    values = {"name": role, "description": fields["description"], "model": model,
              "developer_instructions": body}
    return "".join(key + " = " + json.dumps(value, ensure_ascii=False) + "\n" for key, value in values.items())


def global_kit(home=None):
    return Path(home or Path.home()).expanduser().resolve() / ".claude/gov-kit"


def globally_installed():
    kit = global_kit()
    return (kit / "global-files.json").is_file() and (kit / "govhook-global").is_file()


def kit_text(content, kit):
    return content.replace("{{KIT_PATH}}", str(Path(kit).resolve()))


def global_hooks(kit, adapter, source=None):
    filename = "claude/settings.fragment.json" if adapter == "claude" else "codex/hooks.json"
    result = json.loads(read((source or kit) / filename))["hooks"]
    for event, rows in result.items():
        for row in rows:
            if event == "UserPromptExpansion":
                row["matcher"] = "vision|build|migrate"
            for hook in row["hooks"]:
                hook["command"] = shlex.quote(str(kit / "govhook-global")) + " " + adapter + " " + event
    result.setdefault('SessionStart', []).append({'hooks': [{'type': 'command',
        'command': shlex.quote(str(kit / 'global/graph-aktuell'))}]})
    return {"hooks": result}


def renamed_entry(path):
    """Nur frühere Kit-Einstiege entfernen, deren Besitz separat geprüft wird."""
    return bool(re.search(r"(?:^|/)(?:commands/(?:produkt|bau|umbau)\.md|skills/(?:produkt|bau|umbau)/SKILL\.md)$", path))


def retire_matcher(settings):
    result = copy.deepcopy(settings)
    rows = result.get("hooks", {}).get("UserPromptExpansion", [])
    for row in rows:
        if row.get("matcher") not in ("produkt|bau", "produkt|bau|umbau"):
            continue
        hooks = row.get("hooks", [])
        # Nur unsere vollständig erkennbare lokale Hook-Zeile migrieren.
        if len(hooks) == 1 and hooks[0].get("command") == '"$CLAUDE_PROJECT_DIR"/.gov/govhook claude UserPromptExpansion':
            row["matcher"] = "vision|build|migrate"
    return result


def remove_global_hooks(value, added, original):
    """Nur die bei Installation tatsächlich ergänzten Hook-Zeilen entfernen."""
    result = copy.deepcopy(value)
    for event, rows in added.items():
        if not rows:
            continue
        hooks = result.get("hooks", {})
        if not isinstance(hooks, dict) or not isinstance(hooks.get(event), list):
            continue
        hooks[event] = [row for row in hooks[event] if row not in rows]
        if not hooks[event] and event not in original.get("hooks", {}):
            del hooks[event]
    if result.get("hooks") == {} and "hooks" not in original:
        del result["hooks"]
    return result


def global_install(args, uninstall=False):
    """Vollständige Vorprüfung; Hash-Besitz, Settings-Deltas und Rückrollen bei IO-Fehlern."""
    home = Path(args.home or Path.home()).expanduser().resolve()
    kit = global_kit(home)
    manifest_path = kit / "global-files.json"
    require(not manifest_path.is_symlink(), "Fremde Datei: " + str(manifest_path))
    manifest = json.loads(read(manifest_path)) if manifest_path.exists() else {}
    require(isinstance(manifest, dict), "Ungültige globale Hash-Liste.")
    require(not manifest_path.exists() or (manifest.get("format") == "gov-global-v1" and
            isinstance(manifest.get("files"), dict) and isinstance(manifest.get("settings"), dict)),
            "Fremde oder ungültige globale Hash-Liste: " + str(manifest_path))
    previous = manifest.get("files", {})
    settings_meta = manifest.get("settings", {})
    blocks_meta = manifest.get('blocks', {})
    require(isinstance(blocks_meta, dict) and all(
        rel in ('.claude/CLAUDE.md', '.codex/AGENTS.md') and isinstance(meta, dict) and
        isinstance(meta.get('text'), str) and isinstance(meta.get('created'), bool) and
        isinstance(meta.get('sha256'), str) and re.fullmatch(r'[0-9a-f]{64}', meta['sha256'])
        for rel, meta in blocks_meta.items()), 'Ungültige globale Block-Hash-Liste.')
    require(all(not Path(rel).is_absolute() and ".." not in Path(rel).parts and
                isinstance(digest, str) and re.fullmatch(r"[0-9a-f]{64}", digest)
                for rel, digest in previous.items()), "Ungültige globale Hash-Liste.")
    if uninstall and not manifest:
        print("Keine globale Kit-Installation vorhanden.")
        return
    planned, modes = {}, {}
    conflicts = []

    def safe(path):
        # Auch Symlinks in Elternordnern dürfen nicht aus dem gewählten HOME schreiben.
        return not path.is_symlink() and all(not p.is_symlink() and (not p.exists() or p.is_dir())
                                            for p in path.parents if p != home.parent and p.is_relative_to(home))

    def digest(data):
        return hashlib.sha256(data).hexdigest()

    if not uninstall:
        source = Path(__file__).resolve().parent
        for name in ("gov", "govhook", "govhook-global", "githooks", "templates", "claude", "codex", "global", "skills"):
            origin = source / name
            require(origin.exists(), "Unvollständige Kit-Quelle: " + str(origin))
            for src in sorted(origin.rglob("*")) if origin.is_dir() else [origin]:
                if src.is_file() and "__pycache__" not in src.parts:
                    dest = kit / src.relative_to(source)
                    planned[dest] = src.read_bytes()
                    modes[dest] = src.stat().st_mode & 0o777
        for folder, roles in (("commands", tuple(COMMAND_ROLES)),
                              ("agents", ("planner", "worker", "reviewer", "leser", "schreiber", "pruefer"))):
            for role in roles:
                planned[home / ".claude" / folder / (role + ".md")] = kit_text(
                    read(source / "claude" / folder / (role + ".md")), kit).encode()
        for role in COMMAND_ROLES:
            planned[home / ".agents/skills" / role / "SKILL.md"] = kit_text(codex_skill(source, role), kit).encode()
        for src in sorted((source / "skills").rglob("*")):
            if src.is_file() and "__pycache__" not in src.parts:
                for base in (".claude/skills", ".agents/skills"):
                    dest = home / base / src.relative_to(source / "skills")
                    planned[dest] = src.read_bytes()
                    modes[dest] = src.stat().st_mode & 0o777
        for src in sorted((source / "codex/agents").glob("*.toml")):
            planned[home / ".codex/agents" / src.name] = kit_text(read(src), kit).encode()
        rules = "\n".join(line for line in read(source / "codex/gov.rules").splitlines()
                          if "{{TEST_PATTERN}}" not in line) + "\n"
        planned[home / ".codex/rules/gov.rules"] = rules.encode()
    else:
        planned = {home / rel: None for rel in previous}

    if not uninstall:
        for rel in previous:
            if renamed_entry(rel):
                planned[home / rel] = None

    # Alle Konflikte sammeln; keine Verzeichnisse/Backups vor dieser Prüfung anlegen.
    for path in planned:
        rel = path.relative_to(home).as_posix()
        if not safe(path) or (path.exists() and (not path.is_file() or rel not in previous or
                                                digest(path.read_bytes()) != previous[rel])):
            conflicts.append(str(path))
    require(safe(manifest_path), "Unsicherer Installationspfad: " + str(manifest_path))
    settings_changes = {}
    new_meta = copy.deepcopy(settings_meta)
    for adapter, rel in (("claude", ".claude/settings.json"), ("codex", ".codex/hooks.json")):
        path = home / rel
        if not safe(path) or (path.exists() and not path.is_file()):
            conflicts.append(str(path))
            continue
        original = path.read_bytes() if path.exists() else None
        existing = json.loads(original) if original is not None else {}
        require(isinstance(existing, dict) and isinstance(existing.get("hooks", {}), dict),
                rel + " muss ein JSON-Objekt mit hooks-Objekt sein.")
        if uninstall:
            if rel not in settings_meta or original is None:
                continue
            meta = settings_meta[rel]
            result = remove_global_hooks(existing, meta["added"], json.loads(meta["before"]) if meta["before"] is not None else {})
            # Vorbestehende leere Schlüssel/Formatierung bei unverändertem Stand exakt erhalten.
            before = meta["before"]
            before_value = json.loads(before) if before is not None else {}
            expected = merge_settings(before_value, {"hooks": meta["added"]})
            content = (before.encode() if before is not None else None) if existing == expected else (
                json.dumps(result, ensure_ascii=False, indent=2) + "\n").encode()
        else:
            # Eigene alte globale Matcher aus dem Installationsdelta entfernen;
            # fremde und schon vor Installation vorhandene Hooks bleiben erhalten.
            if rel in settings_meta:
                meta = settings_meta[rel]
                existing = remove_global_hooks(existing, meta["added"],
                    json.loads(meta["before"]) if meta["before"] is not None else {})
            addition = global_hooks(kit, adapter, source)
            for event in addition["hooks"]:
                require(isinstance(existing.get("hooks", {}).get(event, []), list), rel + ": ungültige Hook-Liste " + event)
            result = merge_settings(existing, addition)
            added = {event: [row for row in rows if row not in existing.get("hooks", {}).get(event, [])]
                     for event, rows in addition["hooks"].items()}
            meta = new_meta.setdefault(rel, {"before": original.decode() if original is not None else None, "added": {}})
            meta["added"] = added
            content = (json.dumps(result, ensure_ascii=False, indent=2) + "\n").encode()
        if original != content:
            settings_changes[path] = content
    # Gemischte Regeldateien gehören dem Nutzer; nur der markierte Block gehört dem Kit.
    block_changes, new_blocks = {}, {}
    for rel in ('.claude/CLAUDE.md', '.codex/AGENTS.md'):
        path = home / rel
        if not safe(path) or (path.exists() and not path.is_file()):
            conflicts.append(str(path))
            continue
        original = path.read_bytes() if path.exists() else None
        text = original.decode() if original is not None else ''
        meta = blocks_meta.get(rel)
        if meta:
            owned = meta['text']
            if digest(owned.encode()) != meta['sha256'] or text.count(owned) != 1:
                conflicts.append(str(path) + ': Standardblock verändert')
                continue
            text = text.replace(owned, '', 1)
        if '<!-- gov:standards -->' in text or '<!-- /gov:standards -->' in text:
            conflicts.append(str(path) + ': fremder Standardblock')
            continue
        if not uninstall:
            block = ('\n' if text and not text.endswith('\n') else '') + '<!-- gov:standards -->\n' + read(source / 'global/REGELN.md') + '<!-- /gov:standards -->\n'
            new_blocks[rel] = {'text': block, 'sha256': digest(block.encode()),
                               'created': meta['created'] if meta else original is None}
            text += block
        content = text.encode()
        if uninstall and meta and meta['created'] and not text:
            content = None
        if original != content and (not uninstall or meta):
            block_changes[path] = content
    require(not conflicts, "Fremde oder veränderte Dateien; nichts installiert/geändert:\n" + "\n".join(conflicts))
    changes = {p: data for p, data in planned.items() if (p.read_bytes() if p.exists() else None) != data}
    changes.update(settings_changes)
    changes.update(block_changes)
    if uninstall:
        changes[manifest_path] = None
    else:
        value = {"format": "gov-global-v1", "files": {p.relative_to(home).as_posix(): digest(data) for p, data in planned.items() if data is not None},
                 "settings": new_meta, 'blocks': new_blocks}
        content = (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode()
        if not manifest_path.exists() or manifest_path.read_bytes() != content:
            changes[manifest_path] = content
    # Sicherung unmittelbar vor Änderungen; eigene Dateien sind zusätzlich per Hash belegt.
    if settings_changes or block_changes:
        backup = kit / "sicherung" / dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        require(safe(backup), "Unsicherer Sicherungspfad: " + str(backup))
        for path in {*settings_changes, *block_changes}:
            if path.exists():
                target = backup / path.relative_to(home)
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, target)
    before = {p: (p.read_bytes(), p.stat().st_mode & 0o777) if p.exists() else None for p in changes}
    created_dirs = set()
    try:
        for path, data in changes.items():
            if data is None:
                path.unlink(missing_ok=True)
            else:
                created_dirs.update(p for p in path.parents if not p.exists())
                atomic(path, data.decode())
                path.chmod(modes.get(path, before[path][1] if before[path] else 0o644))
    except OSError:
        for path, old in before.items():
            if old is None:
                path.unlink(missing_ok=True)
            else:
                atomic(path, old[0].decode())
                path.chmod(old[1])
        for folder in sorted(created_dirs, key=lambda p: len(p.parts), reverse=True):
            if folder.exists() and not any(folder.iterdir()):
                folder.rmdir()
        raise
    if uninstall:
        # Nur leere Installationsordner entfernen; Sicherungen und fremde Dateien bleiben.
        folders = {p for target in planned for p in target.parents if p != home and p.is_relative_to(home)}
        for folder in sorted(folders, key=lambda p: len(p.parts), reverse=True):
            if folder.is_dir() and not any(folder.iterdir()):
                folder.rmdir()
    print("Globales Kit " + ("deinstalliert: " if uninstall else "installiert: ") + str(kit))


def install_agents(project, kit, models_only=False, project_hooks=False, update=False):
    """Plant alle Dateien vor dem Schreiben; liefert eigene Commit-Pfade.

    Eigene gleichnamige Dateien werden nie überschrieben. Die Hash-Liste ist
    ausschließlich Installationsbesitz, keine Laufzeit-/Hook-Lebenszeichenprüfung.
    Bei update nur den Änderungsplan liefern; eigene Änderungen melden/überspringen.
    """
    project, kit = Path(project), Path(kit)
    # Bereits lokal installierte Modelle weiter lokal pflegen, auch nach globaler Installation.
    use_global = globally_installed() and not project_hooks and not (
        models_only and (project / ".claude/commands/vision.md").exists())
    # Dateiname aus Phase 2 bleibt kompatibel; Besitzliste umfasst nun beide Adapter.
    manifest_path = project / ".gov/claude-files.json"
    manifest = json.loads(read(manifest_path)) if manifest_path.exists() else {}
    models = json.loads(read(project / ".gov/models.json"))
    pending = {}
    managed = dict(manifest)
    retired = []

    def digest(content):
        return hashlib.sha256(content.encode()).hexdigest()

    def owned(dest, content):
        relative = dest.relative_to(project).as_posix()
        if update and relative != ".gov/govhook" and dest.exists() and (
                relative not in manifest or digest(read(dest)) != manifest[relative]):
            print("Eigene oder veränderte Datei bleibt erhalten: " + relative, file=sys.stderr)
            return
        if dest.exists():
            require((update and relative == ".gov/govhook") or
                    (relative in manifest and digest(read(dest)) == manifest[relative]),
                    "Eigene oder veränderte Datei wird nicht überschrieben: " + relative +
                    ". Bitte umbenennen oder vor der Installation selbst abgleichen.")
        managed[relative] = digest(content)
        if not dest.exists() or read(dest) != content:
            pending[dest] = content

    for relative, expected in manifest.items():
        if renamed_entry(relative) or (update and use_global and relative.startswith(
                (".claude/commands/", ".claude/agents/", ".agents/skills/", ".codex/agents/"))):
            dest = project / relative
            if update and dest.exists() and digest(read(dest)) != expected:
                print("Eigene oder veränderte Datei bleibt erhalten: " + relative, file=sys.stderr)
                continue
            require(not dest.is_symlink() and (not dest.exists() or digest(read(dest)) == expected),
                    "Eigene oder veränderte Datei wird nicht überschrieben: " + relative)
            require(dest.resolve().is_relative_to(project.resolve()), "Unsicherer Installationspfad.")
            if dest.exists():
                retired.append(dest)
            managed.pop(relative, None)

    # Erst Eigentum aller Ziele prüfen, dann schreiben (kein halber Agentensatz).
    for folder, roles in (("commands", tuple(COMMAND_ROLES)), ("agents", ("planner", "worker", "reviewer", "leser", "schreiber", "pruefer"))):
        for role in (() if use_global else roles):
            dest = project / ".claude" / folder / (role + ".md")
            source = kit / "claude" / folder / (role + ".md")
            content = read(dest) if models_only and dest.exists() else kit_text(read(source), project / ".gov")
            content, count = re.subn(r"(?m)^model: .*?$", "model: " + claude_model(models, COMMAND_ROLES.get(role, role)), content, count=1)
            require(count == 1, "Modellzeile fehlt: " + str(source))
            owned(dest, content)
    for role in (() if use_global else COMMAND_ROLES):
        owned(project / ".agents/skills" / role / "SKILL.md", kit_text(codex_skill(kit, role), project / ".gov"))
    for role in (() if use_global else ("planner", "planner_fein", "worker", "worker_mechanisch", "reviewer", "leser", "schreiber", "pruefer")):
        owned(project / ".codex/agents" / (role + ".toml"), kit_text(codex_agent(kit, role, models), project / ".gov"))
    if not models_only:
        owned(project / ".gov/govhook", read(kit / "govhook"))
        # Installierte Distribution bleibt für erneutes gov init vollständig.
        for adapter in ("claude", "codex"):
            for source in sorted((kit / adapter).rglob("*")):
                if source.is_file():
                    owned(project / ".gov" / adapter / source.relative_to(kit / adapter), read(source))
        config = json.loads(read(project / ".gov/config.json"))
        fragment = json.loads(read(kit / "claude/settings.fragment.json"))
        fragment["permissions"]["allow"] = [x.replace("{{TEST_COMMAND}}", config["test_cmd"])
                                               for x in fragment["permissions"]["allow"]]
        if use_global:
            fragment.pop("hooks", None)
        settings = project / ".claude/settings.json"
        existing = json.loads(read(settings)) if settings.exists() else {}
        require(isinstance(existing, dict), ".claude/settings.json muss ein JSON-Objekt sein.")
        if update and use_global:
            existing = remove_project_hooks(existing, kit, "claude")
        merged = json.dumps(merge_settings(retire_matcher(existing), fragment), ensure_ascii=False, indent=2) + "\n"
        if not settings.exists() or read(settings) != merged:
            pending[settings] = merged
        hooks = project / ".codex/hooks.json"
        # Wie Claude: fremde Hook-Einträge erhalten, eigene Einträge nur einmal ergänzen.
        existing = json.loads(read(hooks)) if hooks.exists() else {}
        require(isinstance(existing, dict), ".codex/hooks.json muss ein JSON-Objekt sein.")
        if update and use_global and hooks.exists():
            cleaned = remove_project_hooks(existing, kit, "codex")
            if cleaned != existing:
                pending[hooks] = json.dumps(cleaned, ensure_ascii=False, indent=2) + "\n"
        merged = json.dumps(merge_settings(existing, json.loads(read(kit / "codex/hooks.json"))),
                            ensure_ascii=False, indent=2) + "\n"
        if not use_global and (not hooks.exists() or read(hooks) != merged):
            pending[hooks] = merged
        rules = read(kit / "codex/gov.rules").replace(
            "{{TEST_PATTERN}}", json.dumps(shlex.split(config["test_cmd"]), ensure_ascii=False))
        owned(project / ".codex/rules/gov.rules", rules)
        for adapter, filename in (("claude", "CLAUDE.md"), ("codex", "AGENTS.md")):
            snippet = read(kit / adapter / filename.replace(".md", ".snippet.md"))
            target = project / filename
            previous = read(target) if target.exists() else ""
            if "<!-- project-governance-kit:start -->" not in previous:
                pending[target] = previous + ("\n\n" if previous else "") + snippet
            else:
                def rename_snippet(match):
                    value = match[0]
                    for name, role in COMMAND_ROLES.items():
                        value = value.replace("/" + role, "/" + name)
                    return value
                updated = re.sub(r"<!-- project-governance-kit:start -->.*?<!-- project-governance-kit:end -->",
                                 rename_snippet, previous, flags=re.S)
                if updated != previous:
                    pending[target] = updated
    manifest_text = json.dumps(managed, ensure_ascii=False, indent=2) + "\n"
    if not manifest_path.exists() or read(manifest_path) != manifest_text:
        pending[manifest_path] = manifest_text
    if update:
        return {**pending, **{path: None for path in retired}}
    for path, content in pending.items():
        atomic(path, content)
    for path in retired:
        path.unlink()
    if not models_only:
        (project / ".gov/govhook").chmod(0o755)
    return list(pending) + retired


def remove_project_hooks(settings, kit, adapter):
    """Erkennbare Kit-Kommandos auch aus gemischten Hook-Zeilen entfernen."""
    filename = "claude/settings.fragment.json" if adapter == "claude" else "codex/hooks.json"
    own = json.loads(read(kit / filename))["hooks"]
    result = copy.deepcopy(settings)
    for event, rows in list(result.get("hooks", {}).items()):
        commands = {hook["command"] for row in own.get(event, []) for hook in row["hooks"]}
        kept = []
        for row in rows:
            hooks = [hook for hook in row.get("hooks", []) if hook.get("command") not in commands]
            if hooks == row.get("hooks", []):
                kept.append(row)
            elif hooks:
                kept.append({**row, "hooks": hooks})
        if kept or not rows:
            result["hooks"][event] = kept
        else:
            del result["hooks"][event]
    if result.get("hooks") == {} and settings.get("hooks"):
        del result["hooks"]
    return result


def update_project():
    source = Path(__file__).resolve().parent
    gov = Gov()
    require((gov.main / ".gov/config.json").is_file() and (gov.home / "state.json").is_file(),
            "Projekt ist nicht eingerichtet; zuerst gov init.")
    require(gov.root == gov.main, "Update nur in der Hauptarbeitskopie.")
    with gov.locked(persist=False):
        gov.main_ready()
        require(not gov.git("status", "--porcelain", "--untracked-files=all", cwd=gov.main).strip(),
                "Hauptarbeitskopie ist nicht sauber.")
        # Vor Planung/Schreiben keine Symlinks in Installationszielen verfolgen.
        for name in (".gov", ".claude", ".codex", ".agents"):
            root = gov.main / name
            require(not root.is_symlink() and not any(p.is_symlink() for p in root.rglob("*")),
                    "Unsicherer Installationspfad: " + str(root))
        manifest = json.loads(read(gov.main / ".gov/claude-files.json"))
        require(isinstance(manifest, dict) and all(
            not Path(rel).is_absolute() and ".." not in Path(rel).parts and
            rel.startswith((".gov/", ".claude/", ".codex/", ".agents/"))
            for rel in manifest), "Ungültige Projekt-Hash-Liste.")
        pending, modes = {}, {}
        for name in ("gov", "govhook", "templates", "githooks", "global"):
            origin = source / name
            require(origin.exists(), "Unvollständige Kit-Quelle: " + str(origin))
            for src in sorted(origin.rglob("*")) if origin.is_dir() else [origin]:
                if src.is_file():
                    dest = gov.main / ".gov" / src.relative_to(source)
                    pending[dest] = read(src)
                    modes[dest] = src.stat().st_mode & 0o777
            if origin.is_dir():
                for dest in (gov.main / ".gov" / name).rglob("*"):
                    if dest.is_file() and dest not in pending:
                        pending[dest] = None
        for name in HOOKS:
            dest = gov.common / "gov-hooks" / name
            require(not dest.is_symlink() and not dest.parent.is_symlink(), "Unsicherer Hook-Pfad: " + str(dest))
            pending[dest] = read(source / "githooks" / name)
            modes[dest] = 0o755
        pending.update(install_agents(gov.main, source, update=True))
        changed = []
        for path, content in pending.items():
            mode = modes.get(path, path.stat().st_mode & 0o777 if path.exists() else 0o644)
            if content is None:
                path.unlink(missing_ok=True)
            elif not path.exists() or read(path) != content or path.stat().st_mode & 0o777 != mode:
                atomic(path, content)
                path.chmod(mode)
            else:
                continue
            if path.is_relative_to(gov.main) and not path.is_relative_to(gov.common):
                changed.append(path)
        hooks = gov.common / "gov-hooks"
        if gov.git("config", "--get", "core.hooksPath", check=False).strip() != str(hooks):
            gov.git("config", "core.hooksPath", hooks)
        if changed:
            gov.commit("gov", "Governance-Kit aktualisiert", cwd=gov.main, paths=changed, persist=False)
        print("Governance-Kit aktuell: " + str(gov.main))


def initialize(args):
    source = Path(__file__).resolve().parent
    cwd = Path.cwd().resolve()
    # Schutz des Distributions-Repos, ohne globale Governance wieder zu aktivieren.
    require(not (cwd / "KONZEPT.md").exists() or not (cwd / "Auftrag.md").exists(),
            "Gates werden nicht im Kit-Repo installiert. Zielprojekt verwenden.")
    if run(["git", "rev-parse", "--show-toplevel"], env=clean_env(), check=False).returncode:
        run(["git", "init", "-b", "main"], env=clean_env())
    gov = Gov()
    require(not ((gov.main / "KONZEPT.md").exists() and (gov.main / "Auftrag.md").exists()),
            "Gates werden nicht im Kit-Repo installiert. Zielprojekt verwenden.")
    gov.check_spelling()
    with gov.locked():
        require(gov.root == gov.main, "Installation nur in der Hauptarbeitskopie.")
        if not (gov.home / "state.json").exists() and not (gov.main / ".gov/register.json").exists():
            # Vor allen Kit-Dateien und Kit-Commits messen; erneutes init öffnet nie wieder.
            gov.state["bestand_offen"] = bool(
                gov.result("rev-parse", "--verify", "HEAD").returncode == 0 or
                any(p.is_file() or p.is_symlink() for p in gov.main.rglob("*")
                    if ".git" not in p.relative_to(gov.main).parts))
        if not (gov.main / ".gov/config.json").exists():
            gov.branch = gov.git("branch", "--show-current", cwd=gov.main).strip()
            require(gov.branch, "Installation benötigt einen ausgecheckten Hauptzweig.")
        gov.main_ready()
        files = []
        for directory in ("features", "decisions", "journal", ".gov", ".gov/templates", ".gov/githooks"):
            (gov.main / directory).mkdir(parents=True, exist_ok=True)
        for src in [source / "gov", *sorted((source / "templates").glob("*")), *sorted((source / "githooks").glob("*")), *sorted((source / 'global').glob('*'))]:
            relative = Path("gov") if src.name == "gov" else src.relative_to(source)
            dest = gov.main / ".gov" / relative
            if not dest.exists():
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dest)
                files.append(dest)
        (gov.main / ".gov/gov").chmod(0o755)
        for name in ("config.json", "models.json"):
            dest = gov.main / ".gov" / name
            if not dest.exists():
                shutil.copy2(source / "templates" / name, dest)
                files.append(dest)
                if name == "config.json":
                    data = json.loads(read(dest))
                    data["main_branch"] = gov.branch
                    if args.test_cmd:
                        data["test_cmd"] = args.test_cmd
                    json_write(dest, data)
        gov.config = json.loads(read(gov.main / ".gov/config.json"))
        gov.branch = gov.config["main_branch"]
        ignore = gov.main / ".gitignore"
        old = read(ignore) if ignore.exists() else ""
        if ".worktrees/" not in old.splitlines():
            atomic(ignore, old + ("\n" if old and not old.endswith("\n") else "") + ".worktrees/\n")
            files.append(ignore)
        roadmap = gov.main / "roadmap.md"
        if not roadmap.exists():
            atomic(roadmap, gov.template("roadmap.md"))
            files.append(roadmap)
        hooks = gov.common / "gov-hooks"
        hooks.mkdir(exist_ok=True)
        for name in HOOKS:
            shutil.copy2(source / "githooks" / name, hooks / name)
            (hooks / name).chmod(0o755)
        gov.git("config", "core.hooksPath", hooks)
        gov.save()
        if files:
            gov.commit("gov", "Governance-Kit eingerichtet", paths=files, operation="init")
        product = []
        for name in ("START.md", "vision.md"):
            dest = gov.main / name
            if not dest.exists():
                atomic(dest, gov.template(name, projekt=gov.main.name))
                product.append(dest)
        if product:
            gov.commit("produkt", "Projekteinstieg angelegt", paths=product)
        agent_files = install_agents(gov.main, source, project_hooks=getattr(args, "project_hooks", False))
        if agent_files:
            gov.commit("gov", "Claude-/Codex-Dateien eingerichtet", paths=agent_files, operation="init")
        if not args.no_github and not gov.git("remote").strip() and shutil.which("gh"):
            if run(["gh", "auth", "status"], env=clean_env(), check=False).returncode == 0:
                with gov.token(gov.main, "gov", operation="push", main=True) as env:
                    run(["gh", "repo", "create", "--private", "--source", ".", "--push"], cwd=gov.main, env={**clean_env(), **env})
        elif not args.no_github and gov.git("remote").strip():
            # Erneutes init holt einen abgebrochenen Erst-Push nach.
            remotes = gov.git("remote").splitlines()
            remote = "origin" if "origin" in remotes else remotes[0]
            if not gov.git("ls-remote", "--heads", remote, gov.branch).strip():
                with gov.token(gov.main, "gov", operation="push", main=True) as env:
                    gov.git("push", "-u", remote, gov.branch, env=env)
        print("Governance-Kit eingerichtet: " + str(gov.main))


