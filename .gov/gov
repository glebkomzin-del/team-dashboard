    def probe_gates(self, only=None):
        """Echte Git- und govhook-Prozesse; ausschließlich im bereits fertigen Klon."""
        results = {}
        def probe(n, fn):
            try:
                fn()
                results[f'U-{n:02d}'] = {'bestanden': True, 'detail': 'Wegwerf-Kopie: bestanden'}
            except (Fehler, OSError, ValueError, KeyError) as exc:
                results[f'U-{n:02d}'] = {'bestanden': False, 'detail': str(exc)}
        def denied():
            head = self.output('rev-parse', 'HEAD')
            p = self.git('commit', '--allow-empty', '-m', 'Direkt', check=False, gates=True)
            require(p.returncode != 0, 'Direkter Commit erlaubt.')
            for path, role in [('roadmap.md', 'produkt'),
                               (str(next((self.root / 'decisions').glob('*.md')).relative_to(self.root)), 'produkt'),
                               (str(next(p for p in (self.root / MIGRATION_ARCHIVE).rglob('*') if p.is_file()).relative_to(self.root)), 'produkt')]:
                atomic(self.root / path, read(self.root / path) + '\nVerbotene Änderung\n')
                self.git('add', '--', path)
                with working_directory(self.root):
                    gov = Gov()
                    gov.load()
                    with gov.token(self.root, role, main=True) as env:
                        result = self.git('commit', '-m', 'Verboten', env=env, gates=True, check=False)
                require(result.returncode != 0, 'Gate erlaubt Änderung: ' + path)
                self.git('restore', '--source=' + head, '--staged', '--worktree', '--', path)
            remote = self.root.parent / 'probe-remote.git'
            self.git('init', '--bare', str(remote))
            require(self.git('push', str(remote), 'HEAD:refs/heads/' + self.document_finished()['main'],
                             gates=True, check=False).returncode != 0, 'Direkter Push erlaubt.')
        def allowed():
            with working_directory(self.root):
                gov = Gov()
                with gov.locked():
                    gov.idea('Gate Probe', 'Annahme: isolierte Gate-Probe')
                    fid = next(reversed(gov.state['features']))
                    aid = gov.allocate('A', [fid], 'Probe sichtbar')
                    path = gov.feature_path(fid)
                    atomic(path, read(path).replace('## Recherche\n', '## Recherche\nQuelle: Gate-Probe\n').replace(
                        '## Abnahme\n', '## Abnahme\n- ' + aid + ': Probe sichtbar\n'))
                    gov.commit('produkt', 'Probe ausgearbeitet', paths=[path])
                    gov.set_status(fid, 'ausgearbeitet', 'produkt')
                    gov.set_status(fid, 'freigegeben', 'produkt')
                    gov.worktree(fid)
                    wt = gov.feature_worktree(fid)
                    pid = gov.allocate('P', [aid])
                    tid = gov.allocate('T', [pid])
                    plan = gov.feature_path(fid, wt, 'plan.md')
                    atomic(plan, f'# Plan {fid}\n## Ansatz\nBereiche: gate-probe\n## Offene Fragen an Gleb\n\n'
                           f'## Änderung 1\n### {pid} Probe\nBezug: {aid}\nRiskant: nein\n'
                           f'- {tid} Probe schreiben\n  Kriterium: Probe sichtbar\n  Mechanisch: ja\n  Dateien: gate-probe.txt\n\n' + gov.stand(fid) + '\n')
                    gov.commit('bau', 'Probe geplant', cwd=wt, paths=[plan])
                    gov.set_status(fid, 'in Arbeit', 'bau')
                    gov.task_action('start', tid)
                    atomic(wt / 'gate-probe.txt', 'Probe\n')
                    gov.commit('task', 'Erlaubte Probe', tid, cwd=wt, paths=[wt / 'gate-probe.txt'])
        def adapters():
            for command_name, role in (('vision', 'produkt'), ('build', 'bau')):
                entry_home = Path.home() if globally_installed() else self.root
                require((entry_home / '.claude/commands' / (command_name + '.md')).is_file() and
                        (entry_home / '.agents/skills' / command_name / 'SKILL.md').is_file(), 'Rollen-Einstieg fehlt: ' + command_name)
                for adapter in ('claude', 'codex'):
                    sid = 'migrate-' + role + '-' + adapter
                    data = {'cwd': str(self.root), 'session_id': sid, 'prompt': '/' + command_name, 'command_name': command_name}
                    event = 'UserPromptExpansion' if adapter == 'claude' else 'UserPromptSubmit'
                    command = [sys.executable, str(self.root / '.gov/govhook'), adapter]
                    run([*command, event], cwd=self.root, env=clean_env(), data=json.dumps(data))
                    common = (self.root / self.output('rev-parse', '--git-common-dir')).resolve()
                    require(json.loads(read(common / 'gov/sessions' / (sid + '.json')))['role'] == role, 'Rollenmarke fehlt.')
                    for path, blocked in [('roadmap.md', True), ('vision.md', role == 'bau'), ('probe.py', False)]:
                        request = {**data, 'tool_name': 'Write', 'tool_input': {'file_path': str(self.root / path), 'content': 'Probe'}}
                        response = run([*command, 'PreToolUse'], cwd=self.root, env=clean_env(), data=json.dumps(request), check=False)
                        require((response.returncode != 0) == blocked, 'PreToolUse reagiert falsch: ' + role + '/' + path)
        for number, action in ((24, denied), (26, adapters), (25, allowed)):
            if only is None or only == number:
                probe(number, action)
        return results

    def document_finished(self):
        return json.loads(read(self.root / '.gov/migration.json'))

    def check(self):
        state = self.document('zustand.json')
        require(state['phase'] == 'angewendet', 'Zuerst migrate apply.')
        # Ohne commit am Quellprojekt. Defekte Vorbedingungen werden je Kriterium gemeldet.
        checks = {}
        try:
            with self.candidate() as (candidate, archive):
                checks = self.criteria(candidate, archive)
                checks.update(candidate.probe_gates())
        except (Fehler, OSError, ValueError, KeyError) as exc:
            checks = self.criteria()
            for n in (12, 24, 25, 26):
                checks[f'U-{n:02d}'] = {'bestanden': False, 'detail': 'Wegwerf-Installation: ' + str(exc)}
        review = self.document('pruefung.json') if (self.folder / 'pruefung.json').exists() else {}
        for n in (16, 17, 18, 27):
            checks[f'U-{n:02d}'] = {'bestanden': bool(review.get('frei')), 'art': 'P', 'detail': 'Prüfer-Protokoll; kein Skripturteil'}
        good = all(v['bestanden'] for v in checks.values() if v.get('art') != 'P')
        json_write(self.folder / 'check.json', {'gruen': good, 'fingerprint': self.fingerprint(), 'kriterien': checks})
        for key, value in sorted(checks.items()):
            print(key + ': ' + ('bestanden' if value['bestanden'] else 'nicht bestanden') + ' — ' + value['detail'])
        require(good, 'Umbau-Check nicht grün.')
        return checks

    def review(self, args):
        previous = self.document('pruefung.json') if (self.folder / 'pruefung.json').exists() else {'runden': []}
        require(len(previous['runden']) < 2, 'Höchstens zwei Prüfrunden; Umbau bleibt auf dem Zweig.')
        check = self.document('check.json')
        require(check['gruen'] and check['fingerprint'] == self.fingerprint(), 'Prüfung benötigt aktuellen grünen Check.')
        findings = read(args.befunde) if args.befunde else ''
        require(args.frei or findings.strip(), 'Befunddatei ist leer.')
        # Annahme: Der Eintrag erfolgt durch die Session nach einem frischen Prüfer.
        previous['runden'].append({'frei': args.frei, 'befunde': findings, 'zeit': dt.datetime.now(dt.timezone.utc).isoformat()})
        previous.update(frei=args.frei, fingerprint=self.fingerprint(),
                        annahme='Annahme: Der Eintrag erfolgt durch die Session nach einem frischen Prüfer.')
        json_write(self.folder / 'pruefung.json', previous)
        for n in (16, 17, 18, 27):
            check['kriterien'][f'U-{n:02d}'] = {'bestanden': args.frei, 'art': 'P', 'detail': 'Ergebnis laut Session-Protokoll'}
        json_write(self.folder / 'check.json', check)
        print('Prüfung protokolliert: ' + ('frei' if args.frei else 'blockierende Befunde'))

    def finish(self):
        state = self.document('zustand.json')
        check, review = self.document('check.json'), self.document('pruefung.json')
        fingerprint = self.fingerprint()
        require(check['gruen'] and check['fingerprint'] == fingerprint, 'Aktueller grüner Check fehlt.')
        require(review['frei'] and review['fingerprint'] == fingerprint, 'Aktuelle Prüfung frei fehlt.')
        require((self.folder / 'bericht.md').is_file(), 'Abschlussbericht fehlt.')
        require(self.output('rev-parse', state['main']) == state['main_vor_merge'], 'Hauptzweig wurde parallel geändert.')
        # Der Check hat sämtliche finish-Schritte in einer Kopie dieses Fingerprints
        # durchgeführt. Kein zweiter Modell-/Testlauf zwischen Freigabe und Merge.
        self.commit('Umbau: geprüfter Abschluss')
        self.checkout_main(state['main'])
        self.git('merge', '--no-ff', '--no-edit', 'gov/umbau')
        self.finish_steps()
        graph_update(self.root)
        print('Umbau abgeschlossen; Gates aktiv. Kein Push ausgeführt.')

    def abort(self):
        state = self.document('zustand.json')
        require(self.output('rev-parse', state['main']) == state['main_vor_merge'],
                'Hauptzweig wurde anderweitig verändert; kein automatischer Rücksprung.')
        self.commit('Umbau: abgebrochener Arbeitsstand erhalten')
        # Gemeinsame lokale Hook-Konfiguration wird nicht durch checkout zurückgesetzt.
        config = self.folder / 'hooks/config.json'
        if config.exists():
            old = json.loads(read(config)).get('lokal')
            common = (self.root / self.output('rev-parse', '--git-common-dir')).resolve()
            for saved in (self.folder / 'hooks/git-hooks').glob('*'):
                original = common / 'hooks' / saved.name
                if original.exists() and self.digest(original) == self.digest(saved):
                    original.chmod(saved.stat().st_mode)
            if old:
                self.git('config', '--local', 'core.hooksPath', old)
            else:
                self.git('config', '--local', '--unset-all', 'core.hooksPath', check=False)
        self.checkout_main(state['main'])
        print('Umbau abgebrochen; gov/umbau und Sicherung bleiben erhalten.')

    def push(self):
        done = self.document_finished()
        require(done['abgeschlossen'], 'Umbau nicht abgeschlossen.')
        with working_directory(self.root):
            gov = Gov()
            gov.main_ready()
            remotes = gov.git('remote').splitlines()
            if not remotes:
                print('Kein Remote vorhanden; nichts gepusht.')
                return
            remote = 'origin' if 'origin' in remotes else remotes[0]
            with gov.token(gov.root, 'gov', operation='push', main=True) as env:
                gov.git('push', '--atomic', remote, done['main'], 'refs/tags/' + done['tag'], env=env)
        print('Hauptzweig und Ausgangs-Tag gepusht.')

    def dispatch(self, args):
        done = self.root / '.gov/migration.json'
        if args.action == 'push':
            require(done.is_file(), 'Zuerst Umbau abschließen.')
            self.push()
            return
        cfg = self.root / '.gov/config.json'
        completed_on_main = False
        if cfg.exists():
            main = json.loads(read(cfg)).get('main_branch', 'main')
            completed_on_main = self.git('cat-file', '-e', 'refs/heads/' + main + ':.gov/migration.json', check=False).returncode == 0
        require(not done.exists() and not completed_on_main, 'Umbau bereits abgeschlossen; migrate ist gesperrt.')
        require(not (self.root / '.gov/register.json').exists(), 'Projekt besitzt bereits das Kit; migrate ist einmalig.')
        if args.action == 'bericht':
            require(not self.folder.is_symlink(), 'Umbauordner darf kein Symlink sein.')
            bericht(self.folder / 'berichte', args)
            return
        if args.action == 'scan':
            self.scan()
            return
        if args.action == 'start':
            self.start(args)
            return
        state = self.document('zustand.json')
        require(self.output('branch', '--show-current') == 'gov/umbau', 'Umbau benötigt den Zweig gov/umbau.')
        require(self.root == Path(self.output('worktree', 'list', '--porcelain').splitlines()[0][9:]).resolve(),
                'Umbau nur in der Hauptarbeitskopie.')
        lock = (self.root / self.output('rev-parse', '--git-common-dir')).resolve() / 'umbau.lock'
        with lock.open('a') as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            if args.action == 'review':
                self.review(args)
            elif args.action == 'abbrechen':
                self.abort()
            else:
                getattr(self, args.action)()


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Fehler("Ungültiger Aufruf: Argument fehlt oder ist nicht erlaubt. Hilfe: gov " +
                     (sys.argv[1] + " " if len(sys.argv) > 1 else "") + "--help")


def parser():
    p = Parser(description="Projektwissen, Bau und Abnahme mit Git-Gates verwalten.")
    sub = p.add_subparsers(dest="command", required=True, title="Befehle")
    for name in ("install-global", "uninstall-global"):
        global_parser = sub.add_parser(name)
        global_parser.add_argument("--home", type=Path)
    migrate = sub.add_parser("migrate", help="Bestehendes Projekt ohne aktive Kit-Gates umbauen")
    migrations = migrate.add_subparsers(dest="action", required=True)
    for action in ("scan", "baseline", "apply", "check", "finish", "abbrechen", "push"):
        migrations.add_parser(action)
    for commands in (sub, migrations):
        report = commands.add_parser("bericht", help="Helferbericht von stdin speichern oder Pfade auflisten")
        report.add_argument("id")
        choice = report.add_mutually_exclusive_group(required=True)
        choice.add_argument("--status", choices=("fertig", "blockiert", "frage"))
        choice.add_argument("--liste", action="store_true")
    start = migrations.add_parser("start")
    start.add_argument("--wurzel", type=Path)
    start.add_argument("--zuziehen", type=Path, nargs="+", default=[])
    review = migrations.add_parser("review")
    result = review.add_mutually_exclusive_group(required=True)
    result.add_argument("--frei", action="store_true")
    result.add_argument("--befunde", type=Path)
    init = sub.add_parser("init", help="Zielprojekt einrichten")
    init.add_argument("--no-github", action="store_true")
    init.add_argument("--test-cmd")
    init.add_argument("--project-hooks", action="store_true")
    sub.add_parser("update", help="Installiertes Projekt auf den Kit-Stand aktualisieren")
    idea = sub.add_parser("idea", help="Idee auf dem Hauptzweig anlegen")
    idea.add_argument("--bestand", action="store_true", help="Vorhandenes Feature während der Bestandsaufnahme als fertig erfassen")
    idea.add_argument("name")
    idea.add_argument("sentence")
    sub.add_parser("roadmap")
    status = sub.add_parser("status")
    status.add_argument("feature", nargs="?")
    show = sub.add_parser("show")
    show.add_argument("id")
    status = sub.add_parser("set-status")
    status.add_argument("feature")
    status.add_argument("status")
    status.add_argument("--role", required=True, choices=("produkt", "bau"))
    status.add_argument("--force-reopen", action="store_true", help="Kompatibilitätsoption; umgeht keine Vorbedingung")
    ids = sub.add_parser("id")
    ids.add_argument("action", choices=("next",))
    ids.add_argument("kind", choices=("A", "P", "T", "E"))
    ids.add_argument("parents", nargs="*")
    ids.add_argument("--parent", action="append")
    ids.add_argument("--id", help="Optional erwartete nächste Kennung; keine Wiederverwendung")
    ids.add_argument("--text", default="")
    ids.add_argument("--title")
    ids.add_argument("--reason")
    ids.add_argument("--alternatives")
    ids.add_argument("--role", choices=("produkt", "bau"))
    replace = sub.add_parser("replace")
    replace.add_argument("id")
    replace.add_argument("--by", required=True)
    verify = sub.add_parser("verify")
    verify.add_argument("--task")
    verify.add_argument("--feature")
    task = sub.add_parser("task")
    task.add_argument("action", choices=("start", "done", "fail", "park"))
    task.add_argument("id")
    task.add_argument("--reviewed", action="store_true", help="Reviewer nach zwei Fehlschlägen hat geprüft")
    review = sub.add_parser("package-review", help="Reviewer-Ergebnis für ein riskantes Paket eintragen")
    review.add_argument("id")
    outcome = review.add_mutually_exclusive_group(required=True)
    outcome.add_argument("--frei", action="store_true")
    outcome.add_argument("--befunde")
    next_ = sub.add_parser("next")
    next_.add_argument("id")
    lock = sub.add_parser("lock")
    lock.add_argument("action", choices=("take", "release", "list"))
    lock.add_argument("id", nargs="?")
    lock.add_argument("--holder")
    lock.add_argument("--minutes", type=float, default=90)
    area = sub.add_parser("areas")
    area.add_argument("action", choices=("check",))
    area.add_argument("feature")
    for command in ("worktree", "sync", "merge", "reopen", "guide", "accept"):
        child = sub.add_parser(command)
        child.add_argument("feature")
    fix = sub.add_parser("fixtask")
    fix.add_argument("feature")
    fix.add_argument("text")
    fix.add_argument("--criterion")
    fix.add_argument("--replaces")
    commit = sub.add_parser("commit")
    commit.add_argument("--role", required=True, choices=ROLES)
    commit.add_argument("--task")
    commit.add_argument("-m", "--message", required=True)
    journal = sub.add_parser("journal")
    journal.add_argument("text")
    journal.add_argument("ids", nargs="*")
    start_info = sub.add_parser("start-info")
    start_info.add_argument("--role", choices=("produkt", "bau"), default="bau")
    sub.add_parser("vision-confirm", help="Vision anhand des Produkt-Protokolls einmalig bestätigen")
    models = sub.add_parser("models", help="Agentenmodelle aus models.json übernehmen")
    models.add_argument("action", choices=("apply",))
    hook = sub.add_parser("hook")
    hook.add_argument("name", choices=HOOKS)
    hook.add_argument("args", nargs=argparse.REMAINDER)
    return p


def main():
    args = parser().parse_args()
    if args.command in ("install-global", "uninstall-global"):
        global_install(args, uninstall=args.command == "uninstall-global")
        return
    if args.command == "migrate":
        Migrate().dispatch(args)
        return
    if args.command == "init":
        initialize(args)
        return
    if args.command == "update":
        update_project()
        return
    gov = Gov()
    require(args.command == "hook" or (gov.home / "state.json").exists(), "Projekt ist nicht eingerichtet; zuerst gov init.")
    if args.command == "hook":
        # Hooks lesen atomaren Stand; kein erneutes flock im Kindprozess des
        # bereits gesperrten gov commit/merge (sonst Selbstblockade).
        gov.hook(args.name, args.args)
        return
    with gov.locked():
        c = args.command
        if c == "bericht":
            require(re.fullmatch(r'(?:F-\d{3,}|P-\d{3,}-\d+|T-\d{3,}-\d+-\d+)', args.id),
                    "Bericht benötigt eine Task-, Paket- oder Feature-Kennung.")
            gov.ident(args.id)
            bericht(gov.home / "berichte", args)
        elif c == "idea":
            gov.idea(args.name, args.sentence, args.bestand)
        elif c in ("roadmap", "status"):
            print(gov.status(args.feature) if c == "status" and args.feature else read(gov.main / "roadmap.md"))
        elif c == "show":
            gov.show(args.id)
        elif c == "set-status":
            gov.set_status(args.feature, args.status, args.role)
        elif c == "id":
            gov.new_id(args)
        elif c == "replace":
            gov.replace(args.id, args.by)
        elif c == "verify":
            gov.verify(args.feature, args.task)
            print("Prüfung grün: Kennungen, Richtung, Abdeckung, ersetzte Kriterien und Projekttests.")
        elif c == "task":
            gov.task_action(args.action, args.id, args.reviewed)
        elif c == "package-review":
            gov.package_review(args.id, args.frei, args.befunde)
        elif c == "next":
            print(gov.next_action(args.id))
        elif c == "commit":
            if args.role == "gov":
                require(gov.git("branch", "--show-current").strip() != gov.branch and
                        gov.result("rev-parse", "-q", "--verify", "MERGE_HEAD").returncode == 0,
                        "gov commit --role gov ist nur zur Konfliktauflösung nach gov sync auf einem Neben-Zweig erlaubt.")
            gov.commit(args.role, args.message, args.task)
        elif c == "journal":
            gov.journal(args.text, args.ids)
        elif c == "areas":
            print("Bereiche frei: " + ", ".join(gov.areas_check(args.feature, gov.feature_worktree(args.feature))))
        elif c == "lock":
            holder = args.holder or os.environ.get("GOV_SESSION_ID", str(gov.root))
            if args.action == "list":
                print(json.dumps(gov.state["locks"], ensure_ascii=False, indent=2))
            else:
                require(args.id, "Sperrziel fehlt.")
                if args.action == "take":
                    gov.take_lock(args.id, holder, args.minutes)
                else:
                    lock = gov.state["locks"].get(args.id)
                    require(not lock or lock["holder"] == holder or lock["expires"] <= time.time(), "Nur der Halter darf diese Sperre freigeben.")
                    gov.state["locks"].pop(args.id, None)
                gov.save()
        elif c == "reopen":
            gov.set_status(args.feature, "ausgearbeitet", "produkt")
        elif c == "fixtask":
            gov.fixtask(args.feature, args.text, args.criterion, args.replaces)
        elif c == "start-info":
            gov.start_info(role=args.role)
        elif c == "vision-confirm":
            gov.vision_confirm()
        elif c == "models":
            require(gov.root == gov.main, "Modelle nur in der Hauptarbeitskopie anwenden.")
            gov.main_ready()
            files = install_agents(gov.main, Path(__file__).resolve().parent, models_only=True)
            # Auch die auslösende Modell-Konfiguration gehört in diesen Commit.
            if gov.git("status", "--porcelain", "--", ".gov/models.json").strip():
                files.append(gov.main / ".gov/models.json")
            if files:
                gov.commit("gov", "Claude-/Codex-Modelle angewendet", paths=files)
            print("Claude-/Codex-Modelle angewendet.")
        else:
            getattr(gov, c)(args.feature)


if __name__ == "__main__":
    try:
        main()
    except (Fehler, OSError, ValueError, KeyError) as exc:
        print("Fehler: " + str(exc), file=sys.stderr)
        sys.exit(1)
