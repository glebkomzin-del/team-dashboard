ID = re.compile(r"\b(?:F-\d{3,}|A-\d{3,}-\d+|P-\d{3,}-\d+|T-\d{3,}-\d+-\d+|E-\d{3,})\b")
STAND = re.compile(r"<!-- gov:stand -->.*?<!-- /gov:stand -->", re.S)
ROLES = ("produkt", "bau", "task", "gov")
COMMAND_ROLES = {"vision": "produkt", "build": "bau", "migrate": "umbau"}
HOOKS = ("pre-commit", "commit-msg", "pre-merge-commit", "reference-transaction", "pre-push")


def graph_update(cwd):
    try:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve().parent / 'global/graph-aktuell'),
                          '--cwd', str(cwd)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, env=clean_env())
    except OSError:
        pass


TRANSITIONS = {
    ("Idee", "ausgearbeitet"): "produkt",
    ("ausgearbeitet", "freigegeben"): "produkt",
    ("freigegeben", "in Arbeit"): "bau",
    ("in Arbeit", "zur Abnahme"): "bau",
    ("zur Abnahme", "fertig"): "bau",
    ("zur Abnahme", "in Arbeit"): "bau",
    ("zur Abnahme", "ausgearbeitet"): "bau",
    ("fertig", "ausgearbeitet"): "produkt",
}


class Fehler(Exception):
    pass


def require(condition, message):
    if not condition:
        raise Fehler(message)


def clean_env():
    env = os.environ.copy()
    # Git dokumentiert das Entfernen lokaler Git-Variablen für fremde Repos.
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_PREFIX",
                "GIT_COMMON_DIR", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
                "GIT_IMPLICIT_WORK_TREE"):
        env.pop(key, None)
    env["GIT_TERMINAL_PROMPT"] = "0"
    return env


def run(args, cwd=None, env=None, check=True, data=None):
    p = subprocess.run(args, cwd=cwd, env=env, input=data, text=True,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check and p.returncode:
        raise Fehler("Befehl fehlgeschlagen: " + " ".join(map(str, args[:3])) + "\n" + p.stderr.strip() + "\n" + p.stdout.strip())
    return p


def atomic(path, content):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="." + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def json_write(path, value):
    atomic(path, json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def read(path):
    return Path(path).read_text(encoding="utf-8")


def report_paths(base, ident):
    require(isinstance(ident, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', ident),
            'Bericht-ID muss eine Kennung oder ein Bereich ohne Pfadbestandteile sein.')
    folder = base / ident
    require(not base.is_symlink() and not folder.is_symlink(), 'Berichtpfad darf kein Symlink sein.')
    return sorted((p for p in folder.glob('*.md') if p.stem.isdigit()), key=lambda p: int(p.stem))


def bericht(base, args):
    paths = report_paths(base, args.id)
    if args.liste:
        for path in paths:
            print(path)
        return
    body = sys.stdin.read()
    require(len(body.splitlines()) <= 15, 'Bericht abgelehnt: höchstens 15 Zeilen erlaubt.')
    missing = [name for name in ('Ergebnisort', 'Prüfung', 'Entdeckungen', 'Offen')
               if not re.search(r'^(?:#{1,6} +)?' + name + r'(?::(?: .*)?|[ \t]*)$', body, re.M)]
    require(not missing, 'Bericht abgelehnt: Pflichtüberschrift fehlt: ' + ', '.join(missing))
    folder = base / args.id
    folder.mkdir(parents=True, exist_ok=True)
    # Exklusives Erstellen schützt auch gleichzeitige Helfer ohne gemeinsame Gov-Sperre.
    attempt = max((int(p.stem) for p in paths), default=0) + 1
    while True:
        path = folder / (str(attempt) + '.md')
        try:
            with path.open('x', encoding='utf-8') as f:
                f.write('Status: ' + args.status + '\n' + body.rstrip('\n') + '\n')
            break
        except FileExistsError:
            attempt += 1
    print(path)


def slug(value):
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-") or "feature"


def section(text, title):
    m = re.search(r"^## " + re.escape(title) + r"\s*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1) if m else ""


def without_comments(text):
    return re.sub(r"<!--.*?-->", "", text, flags=re.S)


class Gov:
    def __init__(self):
        # Lokaler Hook-Index bleibt für staged-Prüfungen erhalten; fremde Kopien
        # bekommen immer clean_env(), insbesondere bei commit --only.
        self.root = Path(run(["git", "rev-parse", "--show-toplevel"]).stdout.strip()).resolve()
        common = self.git("rev-parse", "--git-common-dir").strip()
        self.common = (self.root / common).resolve()
        self.home = self.common / "gov"
        listing = self.git("worktree", "list", "--porcelain", "-z")
        self.main = Path(next(x[9:] for x in listing.split("\0") if x.startswith("worktree "))).resolve()
        config = self.main / ".gov/config.json"
        self.config = json.loads(read(config)) if config.exists() else {
            "main_branch": "main", "tests_dir": "tests", "test_cmd": "python3 -m unittest discover -s tests"}
        self.branch = self.config["main_branch"]
        self.state = {}

    def git(self, *args, cwd=None, check=True, local_index=False, env=None):
        target = Path(cwd or self.root).resolve()
        environment = (os.environ.copy() if local_index and target == self.root else clean_env())
        if env:
            environment.update(env)
        return run(["git", "-C", str(target), *map(str, args)], env=environment, check=check).stdout

    def result(self, *args, cwd=None):
        return run(["git", "-C", str(cwd or self.root), *map(str, args)], env=clean_env(), check=False)

    @contextlib.contextmanager
    def locked(self, persist=True):
        self.home.mkdir(parents=True, exist_ok=True)
        with (self.home / "lock").open("a") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            self._locked = True
            try:
                self.load()
                if persist and (self.home / "state.json").exists() and (self.main / ".gov/config.json").exists():
                    self.save()  # Alte Installationen unter derselben Sperre übernehmen.
                yield
            finally:
                self._locked = False

    def load(self):
        p = self.home / "state.json"
        self.state = json.loads(read(p)) if p.exists() else {}
        for key in ("ids", "counters", "features", "tasks", "locks", "areas", "accepted", "rounds"):
            self.state.setdefault(key, {})
        register = self.main / ".gov/register.json"
        if register.exists():
            durable = json.loads(read(register))
            local_features = self.state["features"]
            self.state.update(durable)
            self.state["features"] = {
                fid: {**item, **{k: v for k, v in local_features.get(fid, {}).items()
                                if k in ("branch", "worktree")}}
                for fid, item in durable["features"].items()}
        # Vision-Reife kommt ausschließlich aus dem versionierten Register.
        self.state["vision"] = durable.get("vision", {}) if register.exists() else {}
        # Ein Klon öffnet die abgeschlossene Bestandsaufnahme nicht erneut.
        if "bestand_offen" not in self.state and register.exists():
            self.state["bestand_offen"] = False

    def save(self):
        if getattr(self, "_import_planning", False):
            return
        require(getattr(self, "_locked", False), "Speichern benötigt die gov-Sperre.")
        durable = {key: self.state[key] for key in ("ids", "counters", "accepted")}
        durable["vision"] = self.state.get("vision", {})
        durable["features"] = {fid: {k: v for k, v in item.items() if k in ("slug", "name", "cycle")}
                               for fid, item in self.state["features"].items()}
        register = self.main / ".gov/register.json"
        self.main_ready()
        if not register.exists() or json.loads(read(register)) != durable:
            json_write(register, durable)
        # Auch nach einem gescheiterten Commit muss die Reservierung zuerst in Git.
        self.commit("gov", "Register aktualisiert", cwd=self.main, paths=[register], persist=False)
        transient = {k: v for k, v in self.state.items() if k not in ("ids", "counters", "accepted", "features", "vision")}
        transient["features"] = {fid: {k: v for k, v in item.items() if k in ("branch", "worktree")}
                                 for fid, item in self.state["features"].items()
                                 if any(k in item for k in ("branch", "worktree"))}
        json_write(self.home / "state.json", transient)

    def template(self, filename, **values):
        base = Path(__file__).resolve().parent / "templates" / filename
        text = read(base)
        for key, value in values.items():
            text = text.replace("{{" + key + "}}", value)
        return text

    def main_ready(self):
        require(self.git("branch", "--show-current", cwd=self.main).strip() == self.branch,
                "Die Hauptarbeitskopie muss auf " + self.branch + " stehen.")

    def ident(self, ident, kind=None, active=False):
        item = self.state["ids"].get(ident)
        require(item is not None, "Unbekannte Kennung: " + str(ident))
        require(not kind or ident.startswith(kind + "-"), "Falsche Kennungsart: " + ident)
        require(not active or item["state"] == "aktiv", "Kennung ist ersetzt: " + ident)
        return item

    def feature_of(self, ident):
        self.ident(ident)
        require(ident[0] in "FAPT", "Diese Kennung gehört nicht zu einem Feature.")
        return "F-" + ident.split("-")[1]

    def feature_path(self, fid, cwd=None, name="feature.md"):
        self.ident(fid, "F")
        return Path(cwd or self.root) / "features" / self.state["features"][fid]["slug"] / name

    def feature_worktree(self, fid):
        item = self.state["features"][fid]
        require(item.get("worktree") and Path(item["worktree"]).is_dir(), "Zuerst gov worktree " + fid + " aufrufen.")
        path = Path(item["worktree"])
        require(self.git("branch", "--show-current", cwd=path).strip() == item.get("branch"),
                "Feature-Arbeitskopie steht auf falschem Zweig: " + fid)
        return path

    def statuses(self):
        p = self.main / "roadmap.md"
        rows = {}
        for line in read(p).splitlines() if p.exists() else []:
            cols = [x.strip() for x in line.split("|")]
            if len(cols) == 6 and re.fullmatch(r"F-\d{3,}", cols[1]):
                require(cols[1] not in rows, "Kennung wiederverwendet in Roadmap: " + cols[1])
                rows[cols[1]] = cols[3]
        return rows

    def status(self, fid):
        self.ident(fid, "F")
        require(fid in self.statuses(), "Feature fehlt in der Roadmap: " + fid)
        return self.statuses()[fid]

    def allocate(self, kind, parents, text="", requested=None):
        require(kind in "FAPTE" and len(kind) == 1, "Unbekannte Kennungsart.")
        expected = {"F": "V", "A": "F", "P": "A", "T": "P", "E": "FV"}[kind]
        require(parents, "Übergeordnete Kennung fehlt.")
        for parent in parents:
            require(parent == "V" if kind == "F" else parent[0] in expected,
                    "Verweis muss nach oben zeigen: " + kind + " → " + parent)
            if parent != "V":
                self.ident(parent, active=True)
        require(kind in "PE" or len(parents) == 1, "Genau eine übergeordnete Kennung erforderlich.")
        if kind in "APT":
            features = {self.feature_of(x) for x in parents}
            require(len(features) == 1, "Eltern müssen zum selben Feature gehören.")
            prefix = next(iter(features)).split("-")[1]
            if kind == "T":
                prefix = parents[0][2:]
            key = kind + "-" + prefix
        else:
            key = kind
        number = self.state["counters"].get(key, 0) + 1
        ident = key + "-" + (f"{number:03d}" if kind in "FE" else str(number))
        require(requested is None or requested == ident, "Kennung wiederverwendet oder nicht die nächste freie Kennung: " + str(requested))
        require(ident not in self.state["ids"], "Kennung wiederverwendet: " + ident)
        self.state["counters"][key] = number
        self.state["ids"][ident] = {"parents": parents, "state": "aktiv", "text": text}
        if kind == "T":
            self.state["tasks"][ident] = {"status": "offen", "failures": 0, "since": ""}
        # Reservierungen werden vor jedem weiteren Dateizugriff dauerhaft geschrieben.
        self.save()
        return ident

    def token_path(self, cwd):
        return self.home / "tokens" / (hashlib.sha256(str(Path(cwd).resolve()).encode()).hexdigest() + ".json")

    @contextlib.contextmanager
    def token(self, cwd, role, task=None, operation="commit", main=False, paths=None):
        p = self.token_path(cwd)
        nonce = secrets.token_hex(24)
        json_write(p, {"role": role, "task": task, "operation": operation, "main": main,
                       "expires": time.time() + 120, "nonce": nonce, "paths": paths})
        try:
            yield {"GOV_TOKEN": nonce}
        finally:
            p.unlink(missing_ok=True)

    def get_token(self, required=True):
        p = self.token_path(self.root)
        token = json.loads(read(p)) if p.exists() else {}
        valid = (token.get("expires", 0) > time.time() and
                 token.get("nonce") == os.environ.get("GOV_TOKEN") and token.get("role") in ROLES)
        require(not required or valid, "Kein gültiges Commit-Token; nutze gov commit.")
        return token if valid else {}

    def role_branch(self, role, cwd):
        branch = self.git("branch", "--show-current", cwd=cwd).strip()
        require(branch, "Commits auf abgelöstem HEAD sind nicht erlaubt.")
        require(role != "produkt" or branch == self.branch, "Produkt-Commits sind nur auf dem Hauptzweig erlaubt.")
        require(role not in ("bau", "task") or branch.startswith("feat/"),
                "Bau- und Task-Commits sind nur auf Feature-Zweigen erlaubt.")
        return branch

    def commit(self, role, message, task=None, cwd=None, paths=None, operation="commit", persist=True):
        cwd = Path(cwd or self.root)
        branch = self.role_branch(role, cwd)
        if task:
            self.ident(task, "T", active=True)
        require(role != "task" or task, "Code-Commit benötigt eine Task-Kennung.")
        if paths:
            paths = [str(Path(p).relative_to(cwd)) if Path(p).is_absolute() else str(p) for p in paths]
            self.git("add", "--", *paths, cwd=cwd)
            if self.result("diff", "--cached", "--quiet", "--", *paths, cwd=cwd).returncode == 0:
                return
        if persist:
            self.save()
        with self.token(cwd, role, task, operation, branch == self.branch, paths) as env:
            args = ["commit", "-m", message]
            if paths:
                args += ["--only", "--", *paths]
            self.git(*args, cwd=cwd, env=env)
        if role == "bau":
            for fid, item in self.state["features"].items():
                if item.get("branch") == branch and self.feature_path(fid, cwd, "plan.md").exists():
                    self.state["areas"][fid] = self.area_values(fid, cwd)
            self.save()

    def journal(self, text, ids=()):
        self.main_ready()
        require("\n" not in text and "\r" not in text, "Journalereignisse bestehen aus einer Zeile.")
        for ident in ids:
            self.ident(ident)
        month = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m")
        p = self.main / "journal" / (month + ".md")
        old = read(p) if p.exists() else self.template("journal.md", monat=month)
        line = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds") + " " + " ".join(ids) + " " + text
        atomic(p, old + line.strip() + "\n")
        self.commit("gov", "Journal: " + text, cwd=self.main, paths=[p])

    def criteria(self, fid, cwd=None):
        text = read(self.feature_path(fid, cwd or self.main))
        entries = re.findall(r"^- (A-\d{3,}-\d+):\s*(.+)$", section(text, "Abnahme"), re.M)
        result = {}
        for ident, value in entries:
            self.ident(ident, "A")
            require(ident not in result, "Kennung wiederverwendet: " + ident)
            require(self.feature_of(ident) == fid, "Kriterium gehört zu anderem Feature: " + ident)
            result[ident] = value
        return result

    def active_criteria(self, fid, cwd=None):
        return {k: v for k, v in self.criteria(fid, cwd).items() if self.ident(k)["state"] == "aktiv"}

    def plan(self, fid, cwd=None):
        p = self.feature_path(fid, cwd, "plan.md")
        require(p.exists(), "Plan fehlt: " + str(p))
        return read(p)

    def stand(self, fid):
        lines = ["<!-- gov:stand -->"]
        for tid, task in self.state["tasks"].items():
            if self.feature_of(tid) == fid:
                replaced = self.ident(tid).get("replaced_by")
                lines.append(f"{tid}: {task['status']}; Fehlschläge: {task['failures']}; in Arbeit seit: {task['since']}" +
                             ("; ersetzt durch " + replaced if replaced else "") +
                             ("; Prüfung fehlgeschlagen: " + task["pruefung_fehler"] if task.get("pruefung_fehler") else ""))
        return "\n".join(lines + ["<!-- /gov:stand -->"])

    def update_stand(self, fid, cwd):
        p = self.feature_path(fid, cwd, "plan.md")
        text = read(p)
        require(len(STAND.findall(text)) == 1, "Plan benötigt genau einen gov:stand-Block.")
        atomic(p, STAND.sub(lambda _: self.stand(fid), text))
        self.commit("bau", "Task-Stand " + fid, cwd=cwd, paths=[p])

    def project_tests(self, cwd):
        command = self.config.get("test_cmd", "").strip()
        require(command, "Kein Testbefehl konfiguriert; .gov/config.json:test_cmd setzen.")
        # Annahme: test_cmd ist eine bewusst gewählte lokale Shell-Anweisung.
        p = subprocess.run(command, cwd=cwd, env=clean_env(), shell=True,
                           text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        require(p.returncode == 0, "Projekttests sind rot.\n" + p.stdout + p.stderr)

    def parse_plan(self, fid, cwd):
        text = without_comments(self.plan(fid, cwd))
        packages, tasks = {}, {}
        package = task = None
        for line in text.splitlines():
            pm = re.match(r"### (P-\d{3,}-\d+)\s+(.+)", line)
            tm = re.match(r"- (T-\d{3,}-\d+-\d+)\s+(.+)", line)
            if pm:
                package, task = pm[1], None
                require(package not in packages, "Kennung wiederverwendet: " + package)
                packages[package] = {"refs": [], "tasks": []}
            elif tm:
                task = tm[1]
                require(package is not None, "Task ohne Paket: " + task)
                require(task not in tasks, "Kennung wiederverwendet: " + task)
                tasks[task] = package
                packages[package]["tasks"].append(task)
            elif line.strip().startswith("Bezug:") and package and not task:
                packages[package]["refs"] += ID.findall(line)
            elif line.strip().startswith("Riskant:") and package and not task:
                value = line.strip().removeprefix("Riskant:").strip()
                require(value in ("ja", "nein") and "riskant" not in packages[package],
                        "Riskant: genau einmal mit ja oder nein angeben: " + package)
                packages[package]["riskant"] = value == "ja"
        for pid, item in packages.items():
            registered = self.ident(pid, "P")
            require(self.feature_of(pid) == fid, "Paket gehört zu anderem Feature: " + pid)
            require(item["refs"] and set(item["refs"]) == set(registered["parents"]), "Paket-Bezug stimmt nicht mit dem Register überein: " + pid)
            require("riskant" in item, "Riskant: fehlt im Paket: " + pid)
        for tid, pid in tasks.items():
            require(self.ident(tid, "T")["parents"] == [pid], "Task verweist auf falsches Paket: " + tid)
        return packages, tasks

    def package_finished(self, item):
        active = [t for t in item["tasks"] if self.ident(t)["state"] == "aktiv"]
        return bool(active) and all(self.state["tasks"][t]["status"] == "fertig" for t in active)

    def package_review_gate(self, packages, cwd, starting=None):
        head = self.git("rev-parse", "HEAD", cwd=cwd).strip()
        for pid, item in packages.items():
            if pid == starting or not item["riskant"] or not self.package_finished(item):
                continue
            review = self.state.get("package_reviews", {}).get(pid, {})
            require(review.get("frei") is True and review.get("commit") == head,
                    "Paketfreigabe für aktuellen Stand fehlt: " + pid +
                    "; Reviewer prüfen lassen, dann gov package-review " + pid + " --frei.")

    def package_review(self, pid, frei=False, befunde=None):
        self.ident(pid, "P", active=True)
        fid = self.feature_of(pid)
        cwd = self.feature_worktree(fid)
        require(self.root in (self.main, cwd), "Paket gehört zu einer anderen Feature-Arbeitskopie.")
        require(self.status(fid) == "in Arbeit", "Paketprüfung erfordert Feature-Status in Arbeit.")
        self.check_holder(fid, cwd)
        packages, _ = self.parse_plan(fid, cwd)
        require(pid in packages, "Paket fehlt im Plan: " + pid)
        require(packages[pid]["riskant"], "Paket ist nicht riskant: " + pid)
        require(self.package_finished(packages[pid]), "Alle aktiven Paket-Tasks müssen fertig sein.")
        require(frei or (befunde and befunde.strip()), "Befundtext darf nicht leer sein.")
        # Annahme wie bei task start --reviewed: Die Bau-Session trägt das
        # Ergebnis des tatsächlich aufgerufenen Reviewers ein; kein Aufrufbeweis.
        self.state.setdefault("package_reviews", {})[pid] = {
            "frei": frei, "befunde": befunde or "", "commit": self.git("rev-parse", "HEAD", cwd=cwd).strip()}
        self.save()
        print(pid + (": frei" if frei else ": Befunde"))

    def check_references(self, fid, cwd):
        feature = without_comments(read(self.feature_path(fid, cwd)))
        plan = STAND.sub("", self.plan(fid, cwd))
        documents = [("feature", feature), ("plan", without_comments(plan))]
        for kind, text in documents:
            for ident in ID.findall(text):
                self.ident(ident)
            owner = fid if kind == "feature" else None
            for line in text.splitlines():
                if not line.strip():
                    continue
                definitions = (re.match(r"^- (A-\d{3,}-\d+):", line) if kind == "feature" else
                               re.match(r"^(?:### |\- )(P-\d{3,}-\d+|T-\d{3,}-\d+-\d+)\s", line))
                if definitions:
                    owner = definitions[1]
                if kind == "plan" and line.startswith("## "):
                    owner = fid
                refs = ID.findall(line)
                for ident in refs:
                    if ident == owner or (kind == "feature" and ident == fid):
                        continue
                    if "ersetzt durch " + ident in line:
                        require(owner and self.ident(owner).get("replaced_by") == ident, "Ersetzung stimmt nicht mit dem Register überein.")
                        continue
                    if owner:
                        allowed = {"F": "E", "A": "FE", "P": "AFE", "T": "PAFE"}[owner[0]]
                        require(ident[0] in allowed, "Verweis nach unten: " + owner + " → " + ident)
                        require(ident[0] == "E" or self.feature_of(ident) == fid, "Verweis auf fremdes Feature: " + ident)

    def check_decisions(self, cwd):
        seen = set()
        for path in (Path(cwd) / "decisions").glob("*.md"):
            text = without_comments(read(path))
            title = re.search(r"^# (E-\d{3,})\s", text, re.M)
            require(title, "Entscheidung benötigt eine E-Kennung im Titel: " + path.name)
            eid = title[1]
            self.ident(eid, "E")
            require(eid not in seen, "Kennung wiederverwendet: " + eid)
            seen.add(eid)
            for ident in ID.findall(text):
                self.ident(ident)
                require(ident == eid or ident.startswith("F-"), "Verweis nach unten in Entscheidung: " + ident)

    def verify(self, fid=None, task=None, cwd=None, tests=True):
        cwd = Path(cwd or self.root)
        if task:
            self.ident(task, "T", active=True)
            fid = self.feature_of(task)
        fids = [fid] if fid else [f for f in self.state["features"] if self.feature_path(f, cwd, "plan.md").exists()]
        self.check_decisions(cwd)
        for feature in fids:
            self.check_references(feature, cwd)
            criteria = self.active_criteria(feature, cwd)
            require(criteria, "Keine aktiven Abnahmekriterien: " + feature)
            packages, tasks = self.parse_plan(feature, cwd)
            covered = {a for p in packages.values() if p["tasks"] for a in p["refs"]}
            missing = set(criteria) - covered
            require(not missing, "Abdeckung fehlt: " + ", ".join(sorted(missing)))
            # Auch registrierte, versehentlich aus dem Plan entfernte Tasks bleiben sichtbar.
            registered = {t for t in self.state["tasks"] if self.feature_of(t) == feature and self.ident(t)["state"] == "aktiv"}
            require(registered <= tasks.keys(), "Registrierte Tasks fehlen im Plan: " + ", ".join(sorted(registered - tasks.keys())))
        directories = self.config["tests_dir"]
        directories = [directories] if isinstance(directories, str) else directories
        require(isinstance(directories, list) and all(isinstance(x, str) and x for x in directories),
                "tests_dir muss Text oder eine Liste von Ordnernamen sein.")
        for directory in directories:
            tests_dir = (cwd / directory).resolve()
            require(tests_dir.is_relative_to(cwd.resolve()), "Testordner muss im Projekt liegen.")
            for p in tests_dir.rglob("*") if tests_dir.exists() else []:
                if p.is_file() and not p.is_symlink() and not secret_path(str(p.relative_to(cwd))):
                    text = p.read_bytes().decode("utf-8", errors="replace")
                    for ident in set(ID.findall(p.name + "\n" + text)):
                        if ident.startswith("A-"):
                            require(ident in self.state["ids"], "Unbekanntes Kriterium im Test: " + ident)
                            require(self.ident(ident)["state"] != "ersetzt", "Test verweist auf ersetztes Kriterium: " + ident)
        if task:
            _, tasks = self.parse_plan(fid, cwd)
            require(task in tasks, "Task fehlt im Plan: " + task)
            log = self.git("log", "--format=%B", "HEAD", cwd=cwd)
            require(task in ID.findall(log), "Kein Commit mit Task-Kennung: " + task)
        if tests:
            self.project_tests(cwd)

    def area_values(self, fid, cwd):
        m = re.search(r"^Bereiche:[ \t]*([^\n]*)", self.plan(fid, cwd), re.M)
        return sorted({x.strip().casefold() for x in m[1].split(",") if x.strip()}) if m else []

    def areas_check(self, fid, cwd, areas=None):
        areas = self.area_values(fid, cwd) if areas is None else areas
        require(areas, "Der Plan muss berührte Bereiche nennen.")
        for other, status in self.statuses().items():
            if other != fid and status == "in Arbeit":
                item = self.state["features"][other]
                other_cwd = Path(item.get("worktree", self.main))
                current = self.area_values(other, other_cwd) if self.feature_path(other, other_cwd, "plan.md").exists() else self.state["areas"].get(other, [])
                overlap = set(areas) & set(current)
                require(not overlap, "Warten auf " + other + ": gemeinsame Bereiche " + ", ".join(sorted(overlap)))
        return areas

    def take_lock(self, target, holder, minutes=90):
        self.ident(target)
        require(target[0] in "FT", "Nur Features und Tasks können gesperrt werden.")
        require(minutes > 0, "Sperrdauer muss positiv sein.")
        current = self.state["locks"].get(target, {})
        require(current.get("expires", 0) <= time.time() or current.get("holder") == holder,
                "Sperre belegt: " + target + " durch " + str(current.get("holder")))
        self.state["locks"][target] = {"holder": holder, "expires": time.time() + minutes * 60}

    def check_holder(self, target, cwd):
        lock = self.state["locks"].get(target, {})
        # Annahme: Die späteren Adapter liefern GOV_SESSION_ID; ohne Adapter
        # identifiziert der absolute Arbeitskopie-Pfad den Halter.
        holder = os.environ.get("GOV_SESSION_ID", str(cwd))
        require(lock.get("expires", 0) <= time.time() or lock.get("holder") == holder,
                "Sperre belegt: " + target + " durch " + str(lock.get("holder")))

    def set_status(self, fid, new, role):
        old = self.status(fid)
        require(TRANSITIONS.get((old, new)) == role, "Statusübergang oder Rolle nicht erlaubt: " + old + " → " + new + " (" + role + ")")
        self.main_ready()
        cwd = self.feature_worktree(fid) if role == "bau" else self.main
        self.check_holder(fid, cwd)
        if new == "ausgearbeitet":
            require(self.state.get("vision", {}).get("tragfaehig") is True,
                    "Vision ist noch nicht tragfähig; zuerst gov vision-confirm.")
            p = self.feature_path(fid, self.main)
            research = without_comments(section(read(p), "Recherche"))
            require(re.search(r"https?://\S+|^\s*Quelle:\s*\S+", research, re.M), "Recherche mit Quellen fehlt: " + p.name)
            require(self.active_criteria(fid), "Mindestens ein aktives Abnahmekriterium ist erforderlich.")
        if new == "in Arbeit":
            self.state["areas"][fid] = self.areas_check(fid, cwd)
            self.take_lock(fid, os.environ.get("GOV_SESSION_ID", str(cwd)))
        if new == "zur Abnahme":
            feature = self.feature_path(fid, cwd)
            main_feature = self.result("rev-parse", "--verify", self.branch + ":" + str(feature.relative_to(cwd)), cwd=cwd)
            require(main_feature.returncode == 0 and feature.is_file() and
                    self.git("hash-object", "--no-filters", feature, cwd=cwd).strip() == main_feature.stdout.strip(),
                    "feature.md ist veraltet oder geändert; zuerst gov sync " + fid + " aufrufen.")
            self.verify(fid, cwd=cwd)
            packages, tasks = self.parse_plan(fid, cwd)
            self.package_review_gate(packages, cwd)
            require(all(self.state["tasks"][t]["status"] == "fertig" for t in tasks if self.ident(t)["state"] == "aktiv"), "Es gibt unfertige Tasks.")
            criteria = self.active_criteria(fid, cwd)
            accepted = self.state["accepted"].setdefault(fid, {})
            pending = [a for a, value in criteria.items() if accepted.get(a) != value]
            self.state["rounds"][fid] = {"since": time.time(), "mapping": {str(n): a for n, a in enumerate(pending, 1)}, "criteria": criteria}
        if new == "fertig":
            require(fid in self.state["rounds"], "Keine Abnahmerunde vorhanden.")
            criteria = self.active_criteria(fid, cwd)
            accepted = self.state["accepted"].get(fid, {})
            require(all(accepted.get(a) == v for a, v in criteria.items()), "Für jedes offene Kriterium ist ein protokolliertes passt erforderlich.")
        if old == "fertig":
            self.state["features"][fid]["cycle"] = self.state["features"][fid].get("cycle", 1) + 1
        if new != "in Arbeit":
            self.state["locks"].pop(fid, None)
        p = self.main / "roadmap.md"
        text = read(p)
        text = re.sub(r"^(\| " + re.escape(fid) + r" \| [^|]* \| )[^|]*( \|.*)$", lambda m: m[1] + new + m[2], text, flags=re.M)
        self.state["bestand_offen"] = False
        self.save()
        atomic(p, text)
        self.commit("gov", fid + ": " + new, cwd=self.main, paths=[p])
        self.journal("Status: " + old + " → " + new, [fid])
        print(fid + ": " + new)

    def worktree(self, fid):
        require(self.status(fid) in ("freigegeben", "in Arbeit", "zur Abnahme"), "Bau startet nur nach Freigabe.")
        self.main_ready()
        item = self.state["features"][fid]
        cycle = item.get("cycle", 1)
        suffix = "" if cycle == 1 else "-aenderung-" + str(cycle)
        name = item["slug"] + suffix
        branch = "feat/" + name
        path = self.main / ".worktrees" / name
        if not path.exists():
            self.git("worktree", "add", "-b", branch, path, self.branch, cwd=self.main)
            try:
                if (self.main / 'graphify-out').is_dir():
                    shutil.copytree(self.main / 'graphify-out', path / 'graphify-out', dirs_exist_ok=True)
            except OSError:
                pass
        require(self.git("branch", "--show-current", cwd=path).strip() == branch, "Arbeitskopie steht auf falschem Zweig.")
        item.update(worktree=str(path), branch=branch)
        self.save()
        p = self.feature_path(fid, path, "plan.md")
        if not p.exists():
            atomic(p, self.template("plan.md", id=fid))
            self.update_stand(fid, path)
        print(path)

    def next_action(self, tid):
        self.ident(tid, "T")
        task = self.state["tasks"][tid]
        count = task["failures"]
        return "park" if count >= 4 or task["status"] == "geparkt" else "review" if count == 2 else "retry"

    def task_action(self, action, tid, reviewed=False):
        self.ident(tid, "T", active=True)
        fid = self.feature_of(tid)
        cwd = self.feature_worktree(fid)
        require(self.root in (self.main, cwd), "Task gehört zu einer anderen Feature-Arbeitskopie.")
        task = self.state["tasks"][tid]
        if action in ("done", "fail") and task["status"] != "in Arbeit":
            print("Bereits ausgewertet: " + tid)
            return
        require(self.status(fid) == "in Arbeit", "Task-Bau erfordert Feature-Status in Arbeit.")
        self.check_holder(fid, cwd)
        self.check_holder(tid, cwd)
        packages, tasks = self.parse_plan(fid, cwd)
        require(tid in tasks, "Task fehlt im Plan.")
        if action == "start":
            self.package_review_gate(packages, cwd, starting=tasks[tid])
            require(task["status"] != "fertig", "Fertige Tasks bleiben abgeschlossen; gov fixtask verwenden.")
            require(task["failures"] < 4 and task["status"] != "geparkt", "Task ist geparkt; Korrektur-Task anlegen.")
            require(self.next_action(tid) != "review" or reviewed, "Zuerst Reviewer; danach start --reviewed.")
            self.areas_check(fid, cwd)
            holder = os.environ.get("GOV_SESSION_ID", str(cwd))
            self.take_lock(fid, holder)
            self.take_lock(tid, holder)
            self.state.get("package_reviews", {}).pop(tasks[tid], None)
            task.update(status="in Arbeit", since=dt.datetime.now(dt.timezone.utc).isoformat())
        elif action == "done":
            try:
                self.verify(task=tid, cwd=cwd)
            except Fehler as exc:
                task["pruefung_fehler"] = " ".join(str(exc).split())
                self.save()
                self.update_stand(fid, cwd)
                raise
            task.pop("pruefung_fehler", None)
            task["status"] = "fertig"
        elif action == "fail":
            task["failures"] += 1
            task["status"] = "geparkt" if task["failures"] >= 4 else "offen"
        elif action == "park":
            task["status"] = "geparkt"
        if action != "start":
            self.state["locks"].pop(tid, None)
        self.save()
        self.update_stand(fid, cwd)
        if action != "start":
            self.journal("Task " + task["status"] + "; Fehlschläge: " + str(task["failures"]), [fid, tid])
        print(self.next_action(tid) if action == "fail" else tid + ": " + task["status"])
        if action == "start":
            for path in report_paths(self.home / "berichte", tid):
                print(path)

    def vision_confirm(self):
        if self.state.get("vision", {}).get("tragfaehig") is True:
            print("Vision ist bereits tragfähig (belastbar, nicht endgültig).")
            return
        text = read(self.main / "vision.md")
        for title in ("Wofür", "Für wen", "Was ausdrücklich nicht", "Recherche"):
            body = section(text, title)
            if title == "Was ausdrücklich nicht" and not body:
                body = section(text, "Ausdrücklich nicht")  # bisherige Kit-Vorlage
            require(without_comments(body).strip(), "Vision-Abschnitt fehlt oder ist leer: " + title)
        research = without_comments(section(text, "Recherche"))
        require(re.search(r"https?://\S+|^\s*Quelle:\s*\S+", research, re.M),
                "Recherche mit Quellen fehlt: vision.md")
        digest = hashlib.sha256(text.encode()).hexdigest()
        path = self.home / "accept-log.jsonl"
        confirmation = None
        for raw in read(path).splitlines() if path.exists() else []:
            entry = json.loads(raw)
            require(isinstance(entry, dict), "Ungültiges Bestätigungs-Protokoll.")
            if entry.get("role") != "produkt":
                continue
            require(isinstance(entry.get("timestamp"), (int, float)) and isinstance(entry.get("prompt"), str),
                    "Ungültiges Bestätigungs-Protokoll.")
            # Annahme: Eine eigenständige Antwort bestätigt die zuvor vorgelegte
            # Vision. Hash-Bindung verhindert Zustimmung zu nachträglichem Text.
            answer = entry["prompt"].strip().rstrip(".!?,;:…").casefold()
            if entry.get("vision_sha256") == digest and answer in ("passt", "alles passt", "vision passt"):
                confirmation = entry
        require(confirmation, "Keine klare protokollierte Bestätigung der Produkt-Session für diese Vision.")
        self.state["vision"] = {"tragfaehig": True, "quelle": "Produkt-Protokoll",
                                "timestamp": confirmation["timestamp"], "sha256": digest}
        self.save()
        print("Vision ist tragfähig (belastbar, nicht endgültig).")

    def accept(self, fid):
        require(self.status(fid) == "zur Abnahme", "Abnahme erfordert Status zur Abnahme.")
        round_ = self.state["rounds"].get(fid)
        require(round_, "Keine Abnahmerunde vorhanden.")
        p = self.home / "accept-log.jsonl"
        accepted = self.state["accepted"].setdefault(fid, {})
        for raw in read(p).splitlines() if p.exists() else []:
            entry = json.loads(raw)
            # Annahme: Phase 2/3 schreiben {timestamp: Unix-Sekunden, feature,
            # role: bau, prompt: unveränderter Nutzertext}; kein CLI-Text als Ersatz.
            require(isinstance(entry, dict), "Ungültige Zeile im Abnahme-Protokoll: JSON-Objekt erwartet.")
            require(isinstance(entry.get("timestamp"), (int, float)) and isinstance(entry.get("prompt"), str),
                    "Ungültiges Abnahme-Protokoll: timestamp als Unix-Sekunden und prompt als Text erforderlich.")
            if entry.get("feature") != fid or entry.get("role") != "bau" or entry["timestamp"] <= round_["since"]:
                continue
            for line in entry.get("prompt", "").splitlines():
                line = line.strip().rstrip(".!?,;:…")
                if re.search(r"\bnicht\b", line, re.I):
                    continue
                ids = []
                if line.casefold() == "alles passt" or (line.casefold() == "passt" and len(round_["mapping"]) == 1):
                    ids = list(round_["mapping"].values())
                else:
                    match = re.fullmatch(r"((?:\d+|A-\d{3,}-\d+)(?:\s*,\s*(?:\d+|A-\d{3,}-\d+))*)\s+passt", line, re.I)
                    if match:
                        ids = [round_["mapping"].get(x.strip(), x.strip()) for x in match[1].split(",")]
                for aid in ids:
                    if aid in round_["mapping"].values():
                        accepted[aid] = round_["criteria"][aid]
        self.save()
        self.guide(fid)

    def guide(self, fid):
        round_ = self.state["rounds"].get(fid)
        require(round_, "Noch keine Abnahmeanleitung; zuerst zur Abnahme setzen.")
        accepted = self.state["accepted"].get(fid, {})
        print("Bitte je Kriterium prüfen und mit ‚1 passt‘ oder ‚1 passt nicht, weil …‘ antworten.")
        for number, aid in round_["mapping"].items():
            text = round_["criteria"][aid]
            print(number + ". " + text + (" [passt protokolliert]" if accepted.get(aid) == text else ""))
        self.start_info(fid, expire=False)

    def sync(self, fid):
        cwd = self.feature_worktree(fid)
        require(not self.git("status", "--porcelain", cwd=cwd).strip(), "Arbeitskopie ist nicht sauber; Änderungen zuerst speichern.")
        with self.token(cwd, "gov", operation="sync") as env:
            try:
                self.git("merge", "--no-edit", self.branch, cwd=cwd, env=env)
            except Fehler as exc:
                raise Fehler("Abgleich angehalten. Konflikte in " + str(cwd) + " lösen, mit gov commit --role gov speichern und gov sync erneut aufrufen; sonst parken.\n" + str(exc))

    def merge(self, fid):
        require(self.status(fid) == "fertig", "Zusammenführen nur bei Feature-Status fertig.")
        self.main_ready()
        require(not self.git("status", "--porcelain", cwd=self.main).strip(), "Hauptarbeitskopie ist nicht sauber.")
        self.sync(fid)
        cwd = self.feature_worktree(fid)
        item = self.state["features"][fid]
        branch = item["branch"]
        revision = self.branch + ".." + branch
        # Trailer über Git parsen: gleichnamiger Nachrichtentext genügt nicht.
        roles = self.git("log", "--no-merges", "--format=%H%x00%(trailers:key=Gov-Role,valueonly)%x00",
                         revision, cwd=cwd).split("\0")
        missing_roles = [sha.strip() for sha, role in zip(roles[0::2], roles[1::2]) if not role.strip()]
        require(not missing_roles, "Gov-Role-Trailer fehlt in Feature-Commits: " + ", ".join(missing_roles))
        # Harte Grenze auch für Commits mit umgangenen Hooks; Umbenennungen
        # enthalten mit --no-renames die Löschung der bisherigen Entscheidung.
        raw = self.git("diff", "--name-status", "--no-renames", "-z", self.branch, "HEAD", cwd=cwd).split("\0")
        protected = {"roadmap.md", "vision.md", "START.md", "feature", "journal", ".gov", ".claude",
                     ".codex", ".agents", "AGENTS.md", "CLAUDE.md", "archiv", "schreibweise"}
        for status, path in zip(raw[0::2], raw[1::2]):
            kind = self.category(path)
            require(kind not in protected, "Geschützte Datei im Feature-Diff: " + path)
            if kind == "decisions":
                require(status == "A", "Entscheidungen dürfen nur neu angelegt werden: " + path)
        log = self.git("log", "--format=%B", revision, cwd=cwd)
        # Bei Wiederöffnung gehören frühere, bereits integrierte Tasks zur Historie.
        _, tasks = self.parse_plan(fid, cwd)
        previous = set(ID.findall(self.git("log", "--format=%(trailers:key=Gov-Task,valueonly)", self.branch, cwd=cwd)))
        needed = {t for t in tasks if self.ident(t)["state"] == "aktiv" and t not in previous}
        require(needed <= set(ID.findall(log)), "Task-Kennung fehlt in Feature-Commits: " + ", ".join(sorted(needed - set(ID.findall(log)))))
        self.verify(fid, cwd=cwd)
        accepted = self.state["accepted"].get(fid, {})
        require(all(accepted.get(a) == text for a, text in self.active_criteria(fid, cwd).items()),
                "Abnahme passt nicht zum synchronisierten Stand; Feature wieder öffnen und erneut abnehmen.")
        require(all(self.state["tasks"][t]["status"] == "fertig" for t in tasks if self.ident(t)["state"] == "aktiv"), "Unfertige Tasks verhindern den Merge.")
        with self.token(self.main, "gov", operation="merge", main=True) as env:
            self.git("merge", "--no-ff", "-m", "Feature " + fid + " zusammengeführt", branch, cwd=self.main, env=env)
        self.journal("Feature zusammengeführt", [fid])
        graph_update(self.main)
        remotes = self.git("remote", cwd=self.main).splitlines()
        if remotes:
            remote = "origin" if "origin" in remotes else remotes[0]
            with self.token(self.main, "gov", operation="push", main=True) as env:
                self.git("push", remote, self.branch, cwd=self.main, env=env)
        print(fid + ": zusammengeführt")

    def product_info(self):
        ready = self.state.get("vision", {}).get("tragfaehig") is True
        print("Vision: " + ("tragfähig (belastbar, nicht endgültig)" if ready else "noch nicht tragfähig"))
        def work(path):
            return without_comments(section(read(path), "Arbeitsstand")).strip() if path.exists() else ""
        vision = work(self.main / "vision.md")
        if vision:
            print("Vision – Arbeitsstand:\n" + vision)
        half, waiting, open_ = [], [], []
        for fid, status in self.statuses().items():
            path = self.feature_path(fid, self.main)
            current = work(path)
            if status == "Idee" and current:
                half.append(fid)
            if status == "ausgearbeitet":
                waiting.append(fid)
            if status not in ("Idee", "ausgearbeitet", "freigegeben"):
                continue
            if current:
                open_.append(fid + " – Arbeitsstand:\n" + current)
            if status == "ausgearbeitet":
                item = self.state["features"][fid]
                plan = self.feature_path(fid, Path(item.get("worktree", self.main)), "plan.md")
                questions = without_comments(section(read(plan), "Offene Fragen an Gleb")).strip() if plan.exists() else ""
                # Noch nicht in feature.md übernommene Bau-Fragen sichtbar halten.
                remaining = [line for line in questions.splitlines() if line.strip() and line not in current]
                if remaining:
                    open_.append(fid + " – aus Bau zu übernehmen:\n" + "\n".join(remaining))
        print("Halb ausgearbeitet: " + (", ".join(half) or "keine"))
        print("Wartet auf Freigabe: " + (", ".join(waiting) or "keine"))
        print("Offene Feature-Arbeitsstände:\n" + ("\n".join(open_) or "keine"))

    def start_info(self, fid=None, expire=True, role="bau"):
        if role == "produkt":
            self.product_info()
            return
        if expire:
            for target, lock in list(self.state["locks"].items()):
                if lock["expires"] <= time.time():
                    print("Abgelaufene Sperre freigegeben: " + target + " (" + lock["holder"] + ")")
                    del self.state["locks"][target]
            self.save()
        for feature, item in self.state["features"].items():
            if fid and feature != fid:
                continue
            cwd = Path(item.get("worktree", self.main))
            p = self.feature_path(feature, cwd, "plan.md")
            if p.exists():
                questions = section(read(p), "Offene Fragen an Gleb").strip()
                if questions:
                    print(feature + " – Offene Fragen an Gleb:\n" + questions)
        for tid, task in self.state["tasks"].items():
            if (not fid or self.feature_of(tid) == fid) and self.ident(tid)["state"] == "aktiv" and task["status"] in ("in Arbeit", "geparkt"):
                print(tid + ": " + task["status"] + "; nächste Aktion: " + self.next_action(tid))

    def staged(self, path, old=False):
        spec = ("HEAD:" if old else ":") + path
        return self.git("show", spec, check=False, local_index=True)

    @staticmethod
    def spelling(path):
        first = path.split("/")[0]
        canonical = {x.casefold(): x for x in ("START.md", "vision.md", "roadmap.md", "features", "decisions", "journal")}
        return canonical.get(first.casefold(), first) != first

    def check_spelling(self):
        paths = self.git("ls-files", "-z").split("\0")
        paths += [p.name for p in self.main.iterdir()]
        wrong = sorted({p for p in paths if self.spelling(p)})
        require(not wrong, "Falsche Schreibweise im Projekt: " + ", ".join(wrong) +
                ". Erlaubt sind START.md, vision.md, roadmap.md, features/, decisions/, journal/.")

    @staticmethod
    def category(path):
        if Gov.spelling(path):
            return "schreibweise"
        if path.casefold() == "archiv/governance-alt" or path.casefold().startswith("archiv/governance-alt/"):
            return "archiv"
        if path in ("START.md", "vision.md", "roadmap.md", "AGENTS.md", "CLAUDE.md", ".gitignore"):
            return path
        if path.startswith("_umbau/"):
            return "umbau"
        if path.startswith("features/"):
            return "feature" if path.endswith("/feature.md") else "plan" if path.endswith("/plan.md") else "wissen"
        for prefix in ("decisions", "journal", ".gov", ".claude", ".codex", ".agents"):
            if path.startswith(prefix + "/"):
                return prefix
        return "code"

    def pre_commit(self, token):
        role = token["role"]
        branch = self.role_branch(role, self.root)
        # --no-renames: Verschieben einer Entscheidung enthält dann ein verbotenes D.
        raw = self.git("diff", "--cached", "--name-status", "--no-renames", "-z", local_index=True).split("\0")
        changes = list(zip(raw[0::2], raw[1::2]))
        initializing = token.get("operation") == "init"
        merge_pending = self.result("rev-parse", "-q", "--verify", "MERGE_HEAD").returncode == 0
        sync = role == "gov" and merge_pending and branch != self.branch
        allowed = {
            "produkt": {"START.md", "vision.md", "feature", "decisions"},
            "bau": {"plan", "decisions"},
            "task": {"code", ".gitignore"},
            "gov": {"roadmap.md", "journal", ".gov", ".claude", ".codex", ".agents", "AGENTS.md", "CLAUDE.md", ".gitignore", "plan"},
        }
        for status, path in changes:
            kind = self.category(path)
            require(kind != "schreibweise", "Falsche Schreibweise im Projekt: " + path)
            migrating = role == "gov" and token.get("operation") == "migrate" and branch == self.branch
            if kind == "umbau":
                require(migrating and status == "D", "Umbau-Unterlagen dürfen nur beim Abschluss archiviert werden.")
                continue
            if kind == "archiv":
                require(migrating, "Archiv ist geschützt; nur gov migrate darf es ändern: " + path)
                continue
            if path == ".gov/register.json" and (branch != self.branch or self.root != self.main):
                require(sync and self.staged(path) == self.git("show", self.branch + ":" + path),
                        "Register darf nur in der Hauptarbeitskopie geändert werden.")
            require(not (branch == self.branch and kind == "code"), "Direkte Code-Commits auf dem Hauptzweig sind verboten.")
            if sync:
                # Konfliktauflösung darf übernommene Produkt-Dateien nur unverändert
                # vom Hauptzweig aufnehmen. Code bleibt einem Task-Commit vorbehalten.
                if kind not in allowed[role]:
                    source = self.git("show", self.branch + ":" + path, check=False)
                    require(self.staged(path) == source, "Abgleich darf geschützte Inhalte nur vom Hauptzweig übernehmen: " + path)
            else:
                require(kind in allowed[role] or (migrating and kind in ("feature", "decisions")), "Rolle " + role + " darf diese Datei nicht committen: " + path)
            if kind == "decisions":
                require(status == "A", "Entscheidungen dürfen nur neu angelegt werden: " + path)
            if kind == "journal":
                require(status != "D" and self.staged(path).startswith(self.staged(path, old=True)), "Journal darf nur angehängt werden: " + path)
            if kind == "plan":
                found = re.search(r"(?:^|/)(F-\d{3,})-", path)
                require(found, "Plan-Pfad benötigt eine Feature-Kennung.")
                fid = found[1]
                new = self.staged(path)
                require(STAND.findall(new) == [self.stand(fid)], "Plan-Stand-Block stimmt nicht mit state.json überein.")
                if role == "gov" and not sync and not initializing:
                    old = self.staged(path, old=True)
                    require(STAND.sub("", new) == STAND.sub("", old), "Rolle gov darf nur den Plan-Stand-Block ändern.")
                if role == "bau":
                    item = self.state["features"].get(fid, {})
                    require(item.get("branch") == branch, "Bau darf nur den Plan des eigenen Features ändern.")
                    if self.status(fid) == "in Arbeit":
                        m = re.search(r"^Bereiche:[ \t]*([^\n]*)", new, re.M)
                        areas = sorted({v.strip().casefold() for v in m[1].split(",") if v.strip()}) if m else []
                        self.areas_check(fid, self.root, areas)
            if kind == "feature":
                # Der versionierte Hauptzweig zählt, nicht eine lokal gefälschte
                # Roadmap. Sync darf identische Produkt-Dateien übernehmen.
                if not sync:
                    owner = next((fid for fid, item in self.state["features"].items()
                                  if path == "features/" + item["slug"] + "/feature.md"), None)
                    require(owner, "Feature-Pfad ist nicht registriert: " + path)
                    roadmap = self.git("show", self.branch + ":roadmap.md", check=False)
                    match = re.search(r"^\| " + re.escape(owner) + r" \| [^|]* \| ([^|]+) \|", roadmap, re.M)
                    require(not match or match[1].strip() not in ("in Arbeit", "zur Abnahme"),
                            "feature.md gehört bei in Arbeit/zur Abnahme Bau und ist gesperrt: " + owner)
                ids = re.findall(r"^- (A-\d{3,}-\d+):", self.staged(path), re.M)
                require(len(ids) == len(set(ids)), "Kennung wiederverwendet in feature.md.")
                for aid in ids:
                    self.ident(aid, "A")
        if role == "task":
            tid = token.get("task")
            require(tid, "Code-Commit benötigt eine Task-Kennung.")
            self.ident(tid, "T", active=True)
            fid = self.feature_of(tid)
            require(self.state["features"][fid].get("branch") == branch, "Task gehört nicht zu diesem Feature-Zweig.")
            plan = self.git("show", "HEAD:" + str(self.feature_path(fid).relative_to(self.root)).replace("feature.md", "plan.md"), check=False)
            require(re.search(r"^- " + re.escape(tid) + r"\s", plan, re.M), "Task-Kennung fehlt im versionierten Plan: " + tid)

    def hook(self, name, args):
        self.load()
        if name == "reference-transaction":
            if not args or args[0] != "prepared":
                return
            updates = [x.split() for x in sys.stdin.read().splitlines()]
            # Git merge --abort kann die unveränderte Ref erneut schreiben.
            # Belegt durch den Integrationstest: keine Hauptzweig-Änderung bei old == new.
            if any(len(x) == 3 and x[0] != x[1] and x[2] == "refs/heads/" + self.branch for x in updates):
                token = self.get_token()
                require(token.get("main"), "Hauptzweig darf nur über gov geändert werden.")
            return
        if name == "pre-push":
            token = self.get_token(required=False)
            for line in sys.stdin.read().splitlines():
                local_ref, local_sha, remote_ref, remote_sha = line.split()
                require(set(local_sha) != {"0"}, "Löschen von Remote-Zweigen ist kein erlaubter Push.")
                if remote_ref == "refs/heads/" + self.branch:
                    require(token.get("main") and token.get("operation") == "push", "Push auf den Hauptzweig nur mit gov-Token.")
                if set(remote_sha) != {"0"}:
                    require(self.result("merge-base", "--is-ancestor", remote_sha, local_sha).returncode == 0,
                            "Force-Push (Nicht-Fast-Forward) ist verboten.")
            return
        token = self.get_token()
        if name == "pre-commit":
            self.pre_commit(token)
        elif name == "pre-merge-commit":
            branch = self.git("branch", "--show-current").strip()
            require((branch == self.branch and token.get("main") and token.get("operation") == "merge") or
                    (branch != self.branch and token.get("operation") == "sync"), "Zusammenführen nur über gov merge oder gov sync.")
        elif name == "commit-msg":
            require(args, "Pfad der Commit-Nachricht fehlt.")
            path = Path(args[0])
            message = read(path)
            # Vorhandene Rollen-Trailer können nicht die Token-Rolle überstimmen.
            message = re.sub(r"^Gov-(?:Role|Task):.*\n?", "", message, flags=re.M).strip()
            if token["role"] == "task":
                self.pre_commit(token)
                tid = token["task"]
                if not message.startswith(tid + ":"):
                    message = tid + ": " + message
                message += "\n\nGov-Task: " + tid
            # Task und Rolle müssen im selben Trailer-Block stehen, damit Git
            # Gov-Task später als Trailer statt als Nachrichtentext ausliest.
            message += ("\n" if token["role"] == "task" else "\n\n") + "Gov-Role: " + token["role"] + "\n"
            # Der aufrufende gov-Prozess hält flock bis Git und alle Hooks enden.
            atomic(path, message)
        else:
            raise Fehler("Unbekannter Git-Hook: " + name)

    def idea(self, name, sentence, bestand=False):
        self.main_ready()
        require(self.root == self.main, "Ideen werden in der Hauptarbeitskopie angelegt.")
        require(not bestand or self.state.get("bestand_offen") is True,
                "Bestandsaufnahme ist geschlossen oder das Projekt war bei Einrichtung leer.")
        require(not any(c in name + sentence for c in "\n\r|"), "Name und Satz dürfen keine Zeilenumbrüche oder Tabellen-Trennzeichen enthalten.")
        fid = self.allocate("F", ["V"], sentence)
        self.state["features"][fid] = {"slug": fid + "-" + slug(name), "name": name, "cycle": 1}
        self.save()
        p = self.feature_path(fid, self.main)
        atomic(p, self.template("feature.md", id=fid, name=name, satz=sentence))
        self.commit("produkt", "Idee " + fid, cwd=self.main, paths=[p])
        roadmap = self.main / "roadmap.md"
        status = "fertig" if bestand else "Idee"
        atomic(roadmap, read(roadmap) + f"| {fid} | {name} | {status} | {sentence} |\n")
        self.commit("gov", "Roadmap: " + fid, cwd=self.main, paths=[roadmap])
        self.journal(("Bestand: " if bestand else "Idee: ") + name, [fid])
        print(fid)

    def import_bestand(self, data):
        """Interner U2-Einstieg; benötigt locked(). Schema siehe ENTWURF Abschnitt 15."""
        self.main_ready()
        require(self.root == self.main, "Bestand wird in der Hauptarbeitskopie importiert.")
        require(self.state.get("bestand_offen") is True, "Bestandsaufnahme ist geschlossen.")
        original = copy.deepcopy(self.state)
        aliases, documents, journal = {}, {}, []

        def line(value):
            require(isinstance(value, str) and value.strip() and not any(c in value for c in "\n\r|"),
                    "Importtexte müssen nichtleere Einzelzeilen ohne Tabellen-Trennzeichen sein.")
            return value

        def remember(row, ident):
            key = row.get("key", ident)
            require(isinstance(key, str) and key and key not in aliases and
                    (key == ident or not ID.fullmatch(key)), "Doppelter oder ungültiger Importschlüssel: " + str(key))
            aliases[key] = ident
            return ident

        def resolve(key):
            ident = aliases.get(key, key)
            if ident != "V":
                self.ident(ident)
            return ident

        self._import_planning = True
        try:
            require(isinstance(data, dict), "Bestandsimport benötigt ein Objekt.")
            roadmap = read(self.main / "roadmap.md")
            for row in data.get("features", []):
                name, sentence = line(row["name"]), line(row["sentence"])
                fid = remember(row, self.allocate("F", ["V"], sentence))
                self.state["features"][fid] = {"slug": fid + "-" + slug(name), "name": name, "cycle": 1}
                text = self.template("feature.md", id=fid, name=name, satz=sentence)
                criteria = []
                for criterion in row.get("criteria", []):
                    criterion = {"text": criterion} if isinstance(criterion, str) else criterion
                    value = line(criterion["text"])
                    aid = remember(criterion, self.allocate("A", [fid], value))
                    criteria.append("- " + aid + ": " + value)
                    self.state["accepted"].setdefault(fid, {})[aid] = value
                text = text.replace("## Abnahme\n", "## Abnahme\n" + "\n".join(criteria) + "\n")
                if row.get("source"):
                    text = text.replace("## Recherche\n", "## Recherche\nQuelle: " + line(row["source"]) + "\n")
                documents[self.feature_path(fid, self.main)] = text
                roadmap += f"| {fid} | {name} | fertig | {sentence} |\n"
                journal.append(("Bestand: " + name, [fid]))
            for row in data.get("decisions", []):
                title, value, source = line(row["title"]), line(row["text"]), line(row["source"])
                parents = [resolve(x) for x in row.get("parents", ["V"])]
                eid = remember(row, self.allocate("E", parents, value))
                self.state["ids"][eid]["source"] = source
                path = self.main / "decisions" / (eid + "-" + slug(title) + ".md")
                documents[path] = self.template("decision.md", id=eid, titel=title, text=value,
                    bezug=", ".join(parents), grund=line(row.get("reason", source)),
                    alternativen=line(row.get("alternatives", "Keine festgehalten."))) + "\nQuelle: " + source + "\n"
                journal.append(("Entscheidung: " + title, [eid]))
            for row in data.get("replacements", []):
                old, new = resolve(row["old"]), resolve(row["new"])
                item = self.ident(old, active=True)
                self.ident(new, active=True)
                require(old != new and old[0] == new[0], "Ersetzung benötigt andere Kennung gleicher Art.")
                require(old[0] not in "APT" or self.feature_of(old) == self.feature_of(new),
                        "Ersetzung muss im selben Feature liegen.")
                item.update(state="ersetzt", replaced_by=new)
                journal.append(("ersetzt durch " + new, [old, new]))
            for row in data.get("journal", []):
                row = {"text": row} if isinstance(row, str) else row
                journal.append((line(row["text"]), [resolve(x) for x in row.get("ids", [])]))
            require(aliases or journal, "Bestandsimport ist leer.")
            documents[self.main / "roadmap.md"] = roadmap
            month = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m")
            path = self.main / "journal" / (month + ".md")
            text = read(path) if path.exists() else self.template("journal.md", monat=month)
            stamp = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
            documents[path] = text + "".join(stamp + " " + " ".join(ids) + " " + value + "\n" for value, ids in journal)
        except Exception:
            self.state = original
            raise
        finally:
            self._import_planning = False
        # Erst alle Kennungen gemeinsam reservieren; bei Dateifehlern nie zurücknehmen.
        self.save()
        for path, text in documents.items():
            atomic(path, text)
        self.commit("gov", "Bestand importiert", cwd=self.main, paths=list(documents), operation="migrate")
        return aliases

    def new_id(self, args):
        parents = args.parents + (args.parent or [])
        if args.kind == "E":
            require(args.role in ("produkt", "bau"), "Entscheidungen benötigen Rolle produkt oder bau.")
            self.role_branch(args.role, self.root)
        if args.kind == "T":
            require(len(parents) == 1, "Ein Task benötigt genau ein Paket.")
            self.ident(parents[0], "P", active=True)
            fid = self.feature_of(parents[0])
            require(self.root in (self.main, self.feature_worktree(fid)), "Task gehört zu einer anderen Feature-Arbeitskopie.")
        ident = self.allocate(args.kind, parents, args.text, args.id)
        if args.kind == "T":
            fid = self.feature_of(ident)
            cwd = self.feature_worktree(fid)
            self.update_stand(fid, cwd)
        if args.kind == "E":
            require(args.role in ("produkt", "bau"), "Entscheidungen benötigen Rolle produkt oder bau.")
            self.role_branch(args.role, self.root)
            title = args.title or args.text or "Entscheidung"
            p = self.root / "decisions" / (ident + "-" + slug(title) + ".md")
            require(not p.exists(), "Entscheidungsdatei existiert bereits.")
            atomic(p, self.template("decision.md", id=ident, titel=title, text=args.text,
                                    bezug=", ".join(parents), grund=args.reason or "Noch zu begründen.",
                                    alternativen=args.alternatives or "Keine festgehalten."))
            self.commit(args.role, "Entscheidung " + ident, paths=[p])
            self.journal("Entscheidung: " + title, [ident])
        print(ident)

    def replace(self, old, new):
        item = self.ident(old, active=True)
        self.ident(new, active=True)
        require(old != new and old[0] == new[0], "Ersetzung benötigt eine andere Kennung gleicher Art.")
        if old[0] in "APT":
            require(self.feature_of(old) == self.feature_of(new), "Ersetzung muss im selben Feature liegen.")
        item.update(state="ersetzt", replaced_by=new)
        self.save()
        self.journal("Ersetzt durch " + new, [old, new])
        print(old + " ersetzt durch " + new)

    def fixtask(self, fid, text, criterion=None, replaces=None):
        require(self.status(fid) in ("zur Abnahme", "in Arbeit"), "Korrektur-Task erfordert in Arbeit oder zur Abnahme; fertige Features zuerst mit gov reopen öffnen und freigeben.")
        cwd = self.feature_worktree(fid)
        require(self.root in (self.main, cwd), "Korrektur gehört zu einer anderen Feature-Arbeitskopie.")
        criteria = self.active_criteria(fid, cwd)
        require(criterion or len(criteria) == 1, "Bei mehreren Kriterien --criterion angeben.")
        criterion = criterion or next(iter(criteria))
        require(criterion in criteria, "Korrektur benötigt ein vorhandenes aktives Kriterium.")
        if replaces:
            self.ident(replaces, "T", active=True)
            require(self.feature_of(replaces) == fid, "Korrektur ersetzt nur Tasks desselben Features.")
        if self.status(fid) == "zur Abnahme":
            self.set_status(fid, "in Arbeit", "bau")
        packages, _ = self.parse_plan(fid, cwd)
        pid = next((p for p, item in packages.items() if criterion in item["refs"]), None)
        require(pid, "Für das Kriterium fehlt ein Paket.")
        tid = self.allocate("T", [pid], text)
        p = self.feature_path(fid, cwd, "plan.md")
        plan = read(p)
        start = re.search(r"^### " + re.escape(pid) + r"\s", plan, re.M).start()
        body_start = plan.index("\n", start) + 1
        end = re.search(r"^### |^## |<!-- gov:stand -->", plan[body_start:], re.M)
        offset = body_start + end.start() if end else len(plan)
        addition = f"\n- {tid} {text}\n  Kriterium: {text}\n  Mechanisch: nein\n  Dateien: im Feinplan festlegen\n\n"
        atomic(p, plan[:offset] + addition + plan[offset:])
        if replaces:
            self.replace(replaces, tid)
        self.state["accepted"].setdefault(fid, {}).pop(criterion, None)
        self.save()
        self.update_stand(fid, cwd)
        print(tid)

    def show(self, ident, seen=None):
        seen = set() if seen is None else seen
        if ident in seen:
            return
        seen.add(ident)
        if ident == "V":
            print("V: vision.md")
            return
        item = self.ident(ident)
        print(ident + ": " + item.get("text", "") + (" — ersetzt durch " + item["replaced_by"] if item.get("replaced_by") else ""))
        for parent in item["parents"]:
            self.show(parent, seen)


