MIGRATION_CLASSES = {'Code', 'Fachdoku', 'Beleg', 'Wissen alt', 'Governance alt', 'Streugut', 'Nicht anfassen'}
MIGRATION_ARCHIVE = 'archiv/governance-alt/'


def graph_debris(path):
    return 'graphify-out' in Path(path).parts


def secret_path(path):
    return any(part.lower().startswith('.env') or part.lower().endswith(('.pem', '.key')) or
               'credentials' in part.lower() or 'secret' in part.lower() or
               part.lower() in ('settings.local.json', '.mcp.json') for part in Path(path).parts)


@contextlib.contextmanager
def working_directory(path):
    before = Path.cwd()
    os.chdir(path)
    try:
        yield
    finally:
        os.chdir(before)


class Migrate:
    def __init__(self, root=None):
        self.root = Path(root or Path.cwd()).resolve()
        found = self.git('rev-parse', '--show-toplevel', check=False)
        if found.returncode == 0:
            self.root = Path(found.stdout.strip()).resolve()
        self.folder = self.root / '_umbau'
        self.kit = Path(__file__).resolve().parent

    def git(self, *args, check=True, cwd=None, env=None, data=None, gates=False):
        return run(['git', *([] if gates else ['-c', 'core.hooksPath=/dev/null']), *map(str, args)],
                   cwd=cwd or self.root, env={**clean_env(), **(env or {})}, check=check, data=data)

    def output(self, *args):
        return self.git(*args).stdout.strip()

    def document(self, name):
        return json.loads(read(self.folder / name))

    def safe(self, name):
        p = Path(name)
        require(isinstance(name, str) and name and not p.is_absolute() and
                '..' not in p.parts and '.git' not in p.parts and
                (self.root / p).resolve().is_relative_to(self.root), 'Unsicherer Pfad: ' + str(name))
        require(not any((self.root / Path(*p.parts[:n])).is_symlink()
                        for n in range(1, len(p.parts))), 'Symlink im Elternpfad: ' + name)
        return self.root / p

    def files(self, root=None):
        root = Path(root or self.root)
        found = []
        for base, dirs, names in os.walk(root, followlinks=False):
            dirs[:] = sorted(d for d in dirs if d not in ('.git', '.worktrees', 'graphify-out') and
                              not (Path(base) / d).is_symlink())
            for name in sorted(names):
                relative = (Path(base) / name).relative_to(root).as_posix()
                if not graph_debris(relative):
                    found.append(relative)
        return found

    def tracked(self, ref=None):
        if ref:
            rows = self.git('ls-tree', '-rz', ref).stdout.split('\0')
            return {row.split('\t', 1)[1]: row.split('\t', 1)[0].split()[2]
                    for row in rows if row and not graph_debris(row.split('\t', 1)[1])}
        return [p for p in self.git('ls-files', '-z').stdout.split('\0') if p and not graph_debris(p)]

    @staticmethod
    def legacy(path):
        p = Path(path)
        low = path.casefold()
        return (p.name.casefold() in {'status.md', 'roadmap.md', 'decisions.md', 'decisions.json',
                                     'vision.md', 'worklog.md', 'agents.md', 'claude.md', 'state.md'} or
                any(x.casefold() in ('.governance', 'funktionen', 'wissen', 'knowledge') for x in p.parts) or
                bool(re.search(r'governance|(?:check|pruef)[-_].*(?:gov|rules)|skills/', low)))

    @staticmethod
    def old_reference(text):
        return bool(re.search(r'(?i)\.governance\b|project[- ]governance|governance[-_/]|check[-_]governance|check[-_]rules|(?:^|[ /])(?:funktionen|wissen)/|\bai:(?:checkpoint|handoff)\b', text))

    def old_automation(self, path):
        if secret_path(path) or not (path.startswith(('.github/workflows/', '.claude/skills/', '.agents/skills/')) or
                                     path in ('.claude/settings.json', '.codex/hooks.json')):
            return False
        source = self.root / path
        if not source.is_file() or source.is_symlink():
            return False
        content = read(source)
        if path in ('.claude/settings.json', '.codex/hooks.json'):
            content = json.dumps(json.loads(content).get('hooks', {}))
        return self.old_reference(path + '\n' + content)

    @staticmethod
    def without_old_hooks(data):
        result = copy.deepcopy(data)
        for event, groups in result.get('hooks', {}).items():
            kept = []
            for group in groups:
                if 'hooks' not in group:
                    kept.append(group)
                    continue
                group['hooks'] = [hook for hook in group['hooks']
                                  if not Migrate.old_reference(hook.get('command', ''))]
                if group['hooks']:
                    kept.append(group)
            result['hooks'][event] = kept
        return result

    def scan(self):
        paths = [p for p in self.files() if not p.startswith('_umbau/')]
        git_root = self.git('rev-parse', '--show-toplevel', check=False)
        is_git = git_root.returncode == 0
        repos, retained_repos = [], []
        worktrees = {line[9:] for line in self.output('worktree', 'list', '--porcelain').splitlines()
                     if line.startswith('worktree ')} if is_git else set()
        swift_checkouts = set()
        lock = self.root / 'Package.resolved'
        if is_git and lock.is_file() and not lock.is_symlink() and (self.root / 'Package.swift').is_file():
            try:
                pins = json.loads(read(lock)).get('pins', [])
                swift_checkouts = {str(self.root / '.build/checkouts' / pin['identity']) for pin in pins
                                   if isinstance(pin.get('identity'), str) and
                                   re.fullmatch(r'[A-Za-z0-9_.-]+', pin['identity'])}
            except (ValueError, KeyError, TypeError):
                pass  # Unbekannte Lockformate befreien kein Unter-Repo von B1.
        for base, dirs, names in os.walk(self.root, followlinks=False):
            dirs[:] = sorted(d for d in dirs if d not in ('.worktrees', '_umbau', 'graphify-out') and
                              not (Path(base) / d).is_symlink())
            if '.git' in dirs or '.git' in names:
                location = Path(base)
                if location != self.root:
                    remote = self.git('remote', '-v', cwd=location, check=False)
                    repo = {'pfad': str(location), 'remote': remote.stdout.splitlines()}
                    if str(location) in worktrees:
                        repo['grund'] = 'Registrierte Git-Arbeitskopie; bleibt unberührt.'
                        retained_repos.append(repo)
                        dirs[:] = []
                        continue
                    ignored = is_git and self.git('check-ignore', '-q', '--', str(location), check=False).returncode == 0
                    if ignored and str(location) in swift_checkouts:
                        repo['grund'] = 'Ignorierte SwiftPM-Abhängigkeit aus Package.resolved; bleibt unberührt.'
                        retained_repos.append(repo)
                        dirs[:] = []
                        continue
                    repos.append(repo)
                dirs[:] = [d for d in dirs if d != '.git']
        tracked = self.tracked() if is_git else []
        branches = self.output('for-each-ref', '--format=%(refname:short)', 'refs/heads').splitlines() if is_git else []
        remote_head = self.git('symbolic-ref', '--short', 'refs/remotes/origin/HEAD', check=False) if is_git else None
        main = (remote_head.stdout.strip().removeprefix('origin/') if remote_head and not remote_head.returncode
                else 'main' if 'main' in branches else 'master' if 'master' in branches else None)
        active = self.output('branch', '--show-current') if is_git else None
        comparisons = {}
        for branch in branches:
            if main:
                counts = self.output('rev-list', '--left-right', '--count', main + '...' + branch).split()
                comparisons[branch] = {'ahead': int(counts[1]), 'behind': int(counts[0])}
            else:
                comparisons[branch] = 'unbekannt'
        changed = self.git('status', '--porcelain=v1', '-z').stdout.split('\0') if is_git else []
        changed = [p for p in changed if p and not p[3:].startswith('_umbau/') and not graph_debris(p[3:])]
        folded = {}
        for p in set(paths + tracked):
            folded.setdefault(p.casefold(), []).append(p)
        collisions = [v for v in folded.values() if len(v) > 1]
        collisions += [[p, wanted] for p in tracked for wanted in ('START.md', 'vision.md', 'roadmap.md')
                       if p.casefold() == wanted.casefold() and p != wanted]
        candidates, technology = [], []
        for marker, tech, cmd in [('package.json', 'Node', 'npm test'), ('pyproject.toml', 'Python', 'python3 -m pytest'),
                                  ('Package.swift', 'Swift', 'swift test'), ('Cargo.toml', 'Rust', 'cargo test'),
                                  ('go.mod', 'Go', 'go test ./...'), ('Makefile', 'Make', 'make test')]:
            if marker in paths:
                technology.append(tech)
                candidates.append(cmd)
        if any(p.endswith('.py') for p in paths):
            technology.append('Python')
        if any(p.startswith('tests/') for p in paths):
            candidates.append('python3 -m unittest discover -s tests')
        hooks = self.git('config', '--get', 'core.hooksPath', check=False, gates=True).stdout.strip() if is_git else ''
        hook_names = []
        if is_git:
            common = Path(self.output('rev-parse', '--git-common-dir'))
            common = (self.root / common).resolve()
            hook_names = [str(p) for p in (common / 'hooks').glob('*') if not p.name.endswith('.sample')]
        remote_repos = [r for r in repos if r['remote']]
        ahead = [b for b, c in comparisons.items() if isinstance(c, dict) and c['ahead']]
        blockers = [
            ('B1', not is_git and bool(repos), 'Repo mit Remote als Wurzel; externe Pfade kopieren.', len(remote_repos) != 1),
            ('B2', not is_git and not repos, 'git init und Erstcommit; privates Remote durch Session.', False),
            ('B3', bool(changed), 'umbau-sicherung/<datum>; ohne Geheimnisse sichern und Ausgangsstand wiederherstellen.', False),
            ('B4', bool(ahead), 'Aktiven Zweig nur nach grünen Tests zusammenführen.', len(ahead) > 1),
            ('B5', True, 'Testbasis messen; rot/fehlend als offene Roadmap-Punkte, grünen Teil oder Build verwenden.', False)]
        result = {'git_wurzel': str(self.root) if is_git else None, 'verschachtelte_repos': repos,
                  'erhaltene_repos': retained_repos,
                  'code_ausserhalb_git': [p for p in paths if p not in tracked and Path(p).suffix in
                                         ('.py', '.js', '.ts', '.tsx', '.swift', '.rs', '.go', '.sql', '.sh') and
                                         not any((self.root / p).is_relative_to(r['pfad']) for r in repos)],
                  'zweige': comparisons, 'hauptzweig': main, 'aktiv': active,
                  'arbeitskopien': self.output('worktree', 'list', '--porcelain') if is_git else '',
                  'offene_aenderungen': changed, 'governance_spuren': [p for p in paths if self.legacy(p) or self.old_automation(p)],
                  'core_hooksPath': hooks, 'alte_hooks': hook_names, 'schreibweise_kollisionen': collisions,
                  'technik': sorted(set(technology)) or ['unbekannt'], 'test_kandidaten': sorted(set(candidates)),
                  'testzustand': 'unbekannt', 'groesse_bytes': sum((self.root / p).lstat().st_size for p in paths),
                  'geheimnis_pfade': [p for p in paths if secret_path(p)],
                  'unbekannt': ([] if main or not is_git else ['Hauptzweig unbekannt']) +
                               (['Testbefehl unbekannt'] if not candidates else []),
                  'blocker': {key: {'aktiv': bool(on), 'standardregel': rule, 'frage_noetig': bool(on and question)}
                              for key, on, rule, question in blockers}}
        # Nur dieser Bericht wird geschrieben; kein Git-Zustand oder Projektinhalt verändert.
        json_write(self.folder / 'befund.json', result)
        print('Git-Wurzel: ' + str(result['git_wurzel'] or 'keine') + '; Dateien: ' + str(len(paths)) +
              '; Repos: ' + str(len(repos)) + '; Geheimnis-Pfade: ' + str(len(result['geheimnis_pfade'])))
        print('Blocker: ' + ', '.join(k + (' (Frage nötig)' if v['frage_noetig'] else '')
                                    for k, v in result['blocker'].items() if v['aktiv']))
        return result

    def config(self):
        cfg = self.document('config.json')
        require(isinstance(cfg.get('test_cmd'), str) and cfg['test_cmd'].strip(), 'B5: test_cmd fehlt; grünen Teil/Build bestimmen.')
        dirs = cfg.get('tests_dir')
        require(isinstance(dirs, (str, list)) and bool(dirs), 'B5: tests_dir fehlt.')
        for p in ([dirs] if isinstance(dirs, str) else dirs):
            self.safe(p)
        return cfg

    def commit(self, message):
        paths = sorted(set(self.tracked()) | {p for p in self.files() if p.startswith('_umbau/')})
        require(not any(secret_path(p) for p in paths), 'Geheimnis-Datei darf nicht versioniert werden.')
        if paths:
            self.git('add', '-A', '--', *paths)
        if self.git('diff', '--cached', '--quiet', check=False).returncode:
            self.git('commit', '-m', message)

    def execute(self, command, cwd):
        start = time.monotonic()
        if not command:
            return {'befehl': None, 'exit': None, 'zeit': 0, 'zustand': 'fehlend'}
        # Annahme: Die Session hat diesen lokalen Projektbefehl bewusst ausgewählt.
        p = subprocess.run(command, shell=True, cwd=cwd, env=clean_env(),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {'befehl': command, 'exit': p.returncode, 'zeit': round(time.monotonic() - start, 3)}

    @contextlib.contextmanager
    def tag_copy(self, ref):
        with tempfile.TemporaryDirectory(prefix='gov Umbau Testbasis ') as folder:
            dest = Path(folder) / 'projekt'
            commit = self.output('rev-parse', ref + '^{commit}')
            # Kein clone: Ein Ref wie „main 2“ erscheint dort als Null-Objekt und bricht ihn ab.
            refs = self.output('for-each-ref', '--format=+%(refname):refs/quelle/%(refname:lstrip=2)', 'refs/heads')
            tags = self.output('for-each-ref', '--format=+%(refname):%(refname)', 'refs/tags')
            self.git('init', '--quiet', str(dest))
            self.git('fetch', '--quiet', '--no-tags', '--stdin', str(self.root), cwd=dest, data=refs + '\n' + tags + '\n')
            self.git('checkout', '--quiet', '--detach', commit, cwd=dest)
            yield dest

    def checkout_main(self, main):
        # Ohne core.ignorecase hält Git auf Mac-Dateisystemen vision.md für eine fremde VISION.md.
        if (self.root / '.GIT').exists():
            self.git('config', '--local', 'core.ignorecase', 'true')
        self.git('checkout', main)

    def start(self, args):
        origin = self.root
        require(not ((self.root / 'KONZEPT.md').exists() and (self.root / 'Auftrag.md').exists()),
                'Kein Umbau im Kit-Repo.')
        scan = self.scan()
        if not scan['git_wurzel'] and not args.wurzel:
            remotes = [r for r in scan['verschachtelte_repos'] if r['remote']]
            if len(remotes) == 1:
                args.wurzel = Path(remotes[0]['pfad'])
        if args.wurzel:
            selected = args.wurzel.resolve()
            require(selected.is_dir(), 'Gewählte Wurzel fehlt.')
            other = Migrate(selected)
            require(other.root == selected and other.git('rev-parse', '--git-dir', check=False).returncode == 0,
                    '--wurzel muss eine Git-Wurzel sein.')
            if selected != origin and self.folder.exists():
                for name in self.files(self.folder):
                    dest = selected / '_umbau' / name
                    require(not secret_path(name), 'Geheimnis im Umbau-Eingabeordner.')
                    require(not dest.exists() or name == 'befund.json' or
                            self.digest(dest) == self.digest(self.folder / name), 'Abweichende Umbau-Eingabe am Ziel: ' + name)
                shutil.copytree(self.folder, selected / '_umbau', dirs_exist_ok=True)
            self.root, self.folder = selected, selected / '_umbau'
            scan = self.scan()
        require(not scan['verschachtelte_repos'], 'B1: Verschachtelte Repos: --wurzel wählen; Repos nicht verschachtelt übernehmen.')
        require(not (self.root / '.gov/register.json').exists(), 'Projekt besitzt bereits das Kit.')
        require(not (self.folder / 'zustand.json').exists(), 'Umbau bereits gestartet.')
        copied = []
        for source in args.zuziehen:
            source = source.resolve()
            require(source.exists() and not source.is_relative_to(self.root) and not self.root.is_relative_to(source),
                    '--zuziehen benötigt einen externen, getrennten Pfad.')
            dest = self.root / source.name
            require(not dest.exists(), 'Kopierziel existiert: ' + str(dest))
            require(not source.is_symlink() and not secret_path(source.name), 'Geheimnis-/Symlink-Pfad nicht zuziehen.')
            members = self.files(source) if source.is_dir() else []
            require(not any(secret_path(p) or (source / p).is_symlink() for p in members),
                    'Zuziehen enthält Geheimnisse oder Symlinks; Pfade enger wählen.')
            require(not (source / '.git').exists(), 'Repo nicht als Code kopieren.')
            shutil.copytree(source, dest) if source.is_dir() else shutil.copy2(source, dest)
            copied.append(dest.name)
        if not scan['git_wurzel']:
            self.git('init', '-b', 'main')
            paths = [p for p in self.files() if not secret_path(p) and not p.startswith('_umbau/')]
            if paths:
                self.git('add', '--', *paths)
            self.git('commit', '--allow-empty', '-m', 'Ausgangsstand vor Governance-Umbau')
            scan = self.scan()
        exclude = (self.root / self.output('rev-parse', '--git-common-dir')).resolve() / 'info/exclude'
        old = read(exclude) if exclude.exists() else ''
        if 'graphify-out/' not in old.splitlines():
            atomic(exclude, old + ('\n' if old and not old.endswith('\n') else '') + 'graphify-out/\n')
        require(not any(secret_path(p) for p in self.tracked()), 'Geheimnis-Datei ist versioniert; B3/U-23 zuerst klären.')
        require(scan['hauptzweig'] and scan['aktiv'], 'Hauptzweig oder aktueller Stand unbekannt; echte Lücke klären.')
        main, active = scan['hauptzweig'], scan['aktiv']
        stamp = dt.datetime.now().strftime('%Y%m%d')
        tag = 'vor-umbau-' + stamp
        require(self.git('rev-parse', '--verify', 'refs/tags/' + tag, check=False).returncode != 0 and
                self.git('rev-parse', '--verify', 'refs/heads/gov/umbau', check=False).returncode != 0,
                'Tag oder gov/umbau existiert bereits; nichts wird überschrieben.')
        before = self.output('rev-parse', main)
        # Separater Index: staged/unstaged Änderungen sichern, ohne Geheimnisse zu öffnen.
        dirty = self.git('status', '--porcelain', '-z').stdout
        backup = None
        if any(p and not p[3:].startswith('_umbau/') and not secret_path(p[3:]) and not graph_debris(p[3:]) for p in dirty.split('\0')):
            backup = 'umbau-sicherung/' + stamp + '-' + dt.datetime.now().strftime('%H%M%S%f')
            candidates = (self.output('diff', '--name-only', '--no-renames', '-z', 'HEAD') + '\0' +
                          self.output('ls-files', '--others', '--exclude-standard', '-z')).split('\0')
            paths = [p for p in candidates if p and not secret_path(p) and not p.startswith('_umbau/') and not graph_debris(p)]
            with tempfile.TemporaryDirectory(prefix='gov Index ') as folder:
                env = {'GIT_INDEX_FILE': str(Path(folder) / 'index')}
                self.git('read-tree', 'HEAD', env=env)
                if paths:
                    self.git('add', '-A', '--', *paths, env=env)
                tree = self.git('write-tree', env=env).stdout.strip()
                commit = self.git('commit-tree', tree, '-p', 'HEAD', data='Umbau-Sicherung ohne Geheimnisse\n').stdout.strip()
                self.git('branch', backup, commit)
            paths = [p for p in self.tracked() if not p.startswith('_umbau/')]
            if paths:
                self.git('restore', '--source=HEAD', '--staged', '--worktree', '--', *paths)
        ahead = scan['zweige'].get(active, {}).get('ahead', 0)
        if active != main and ahead:
            require(sum(isinstance(v, dict) and v['ahead'] > 0 for v in scan['zweige'].values()) == 1,
                    'B4: Mehrere Zweige konkurrieren; Frage nötig.')
            cfg = self.config()
            with self.tag_copy('HEAD') as copy_root:
                result = self.execute(cfg['test_cmd'], copy_root)
            require(result['exit'] == 0, 'B4: Tests rot; Frage nötig. Hauptzweig bleibt unverändert.')
            # Erst Zusammenführung in Wegwerf-Kopie prüfen, auch bei divergiertem main.
            with self.tag_copy('HEAD') as copy_root:
                self.git('merge', '--no-edit', before, cwd=copy_root)
                require(self.execute(cfg['test_cmd'], copy_root)['exit'] == 0, 'B4: Zusammengeführte Tests rot; Frage nötig.')
            self.git('checkout', main)
            self.git('merge', '--no-ff', '--no-edit', active)
        elif active != main:
            self.git('checkout', main)
        if copied:
            self.git('add', '--', *copied)
            self.git('commit', '-m', 'Außenbestand kopiert; Originale erhalten')
        self.git('tag', tag)
        self.git('checkout', '-b', 'gov/umbau')
        state = {'tag': tag, 'main': main, 'main_vor_start': before, 'main_vor_merge': self.output('rev-parse', main),
                 'sicherung': backup, 'datum': stamp, 'phase': 'gestartet', 'dateien': self.tracked(tag),
                 'modi': {line.split('\t', 1)[1]: line.split()[0]
                          for line in self.git('ls-tree', '-rz', tag).stdout.split('\0') if line},
                 'annahmen': ['Annahme: Testbefehl und Klassifikation werden durch die Session bestimmt.']}
        json_write(self.folder / 'zustand.json', state)
        self.commit('Umbau: Befund und Sicherung')
        graph_update(self.root)
        print('Umbau gestartet: ' + str(self.root) + '; Tag: ' + tag)

    def baseline(self):
        state, cfg = self.document('zustand.json'), self.config()
        with self.tag_copy(state['tag']) as root:
            result = self.execute(cfg.get('baseline_cmd', cfg['test_cmd']), root)
            green = self.execute(cfg['test_cmd'], root) if result['befehl'] != cfg['test_cmd'] else result
        result['gruener_teil'] = dict(green)
        json_write(self.folder / 'testbasis.json', result)
        require(green['exit'] == 0, 'B5: Kein grüner Test-/Build-Befehl; Frage nötig.')
        require(result['exit'] == 0 or cfg.get('offen'), 'B5: Rote/fehlende Tests als offene Roadmap-Punkte festhalten.')
        self.commit('Umbau: Testbasis')
        print('Testbasis: ' + str(result['exit']) + '; grüner Teil: ' + str(green['exit']))

    def mapping(self):
        state = self.document('zustand.json')
        rows = self.document('umzug.json')['dateien']
        require(isinstance(rows, list), 'umzug.dateien muss eine Liste sein.')
        rows = [r for r in rows if not graph_debris(r['pfad'])]  # Immer Streugut, kein Umzugsauftrag.
        require(state['dateien'] == self.tracked(state['tag']), 'U-06: Ausgangsinventar stimmt nicht mit dem Tag überein.')
        names = [r['pfad'] for r in rows]
        require(len(names) == len(set(names)) and set(names) == set(state['dateien']), 'U-06: Abdeckung muss genau 100 % sein.')
        for row in rows:
            self.safe(row['pfad'])
            require(row['klasse'] in MIGRATION_CLASSES, 'Unbekannte Klasse: ' + str(row['klasse']))
            require(not secret_path(row['pfad']) or row['klasse'] == 'Nicht anfassen', 'Geheimnis gehört zu Nicht anfassen.')
            target = MIGRATION_ARCHIVE + row['pfad'] if row['klasse'] in ('Wissen alt', 'Governance alt') else row['pfad']
            require(row.get('ziel', target) == target, 'Ziel weicht von der Klassentabelle ab: ' + row['pfad'])
        return rows

    def target(self, row):
        return MIGRATION_ARCHIVE + row['pfad'] if row['klasse'] in ('Wissen alt', 'Governance alt') else row['pfad']

    def original_bytes(self, path):
        state = self.document('zustand.json')
        result = subprocess.run(['git', 'cat-file', 'blob', state['tag'] + ':' + path],
                                cwd=self.root, env=clean_env(), capture_output=True)
        require(result.returncode == 0, "Originaldatei im Ausgangs-Tag fehlt: " + path)
        return result.stdout

    def reference_changes(self, rows):
        """Exakte Löschungen am Tag; nur JSON-Trennkommas dürfen zusätzlich entfallen."""
        entries = self.document('umzug.json').get('verweise', [])
        require(isinstance(entries, list), 'umzug.verweise muss eine Liste sein.')
        classes = {r['pfad']: r['klasse'] for r in rows}
        changes = {}
        for entry in entries:
            require(isinstance(entry, dict) and isinstance(entry.get('pfad'), str) and 'zeilen' in entry,
                    'Verweis benötigt pfad und zeilen.')
            path, lines = entry['pfad'], entry['zeilen']
            target = self.safe(path)
            require(classes.get(path) == 'Code' and not secret_path(path) and not target.is_symlink(),
                    'Verweise nur in regulären Code-Dateien: ' + path)
            require(path not in changes and isinstance(lines, list) and lines and
                    all(isinstance(line, str) and line.strip() and '\n' not in line and '\r' not in line for line in lines)
                    and len(lines) == len(set(lines)), 'Verweise benötigen eindeutige Pfade und genaue Zeilen.')
            original = self.original_bytes(path).decode('utf-8')
            parts = original.splitlines(keepends=True)
            for line in lines:
                matches = [i for i, part in enumerate(parts) if part.rstrip('\r\n') == line]
                require(len(matches) == 1, 'Verweiszeile fehlt oder ist mehrdeutig in ' + path + ': ' + line)
                del parts[matches[0]]
            changed = ''.join(parts)
            if path.lower().endswith('.json'):
                # Kein Neuformatieren: nur überflüssiges Trennkomma vor einer schließenden Zeile.
                changed = re.sub(r',([ \t]*\r?\n[ \t]*[}\]])', r'\1', changed)
                try:
                    json.loads(changed)
                except ValueError as exc:
                    raise Fehler('Verweis-Löschung ergibt ungültiges JSON in ' + path + ': ' + str(exc))
            changes[path] = changed.encode('utf-8')
        return changes

    def reference_exceptions(self):
        """Begründete U-15-Fehlalarme: pfad:zeile aus umzug.json, sichtbar im Bericht."""
        entries = self.document('umzug.json').get('verweise_ok', [])
        require(isinstance(entries, list), 'umzug.verweise_ok muss eine Liste sein.')
        report = read(self.folder / 'bericht.md') if entries else ''
        allowed = set()
        for entry in entries:
            require(isinstance(entry, dict) and isinstance(entry.get('pfad'), str) and isinstance(entry.get('zeile'), int)
                    and isinstance(entry.get('grund'), str) and entry['grund'].strip(),
                    'verweise_ok benötigt pfad, zeile und grund.')
            key = f"{entry['pfad']}:{entry['zeile']}"
            require(key in report, 'U-15: Ausnahme fehlt im Bericht: ' + key)
            allowed.add(key)
        return allowed

    def code_references(self, rows, root, allowed=()):
        """Statische Pfad- und npm-run-Verweise einschließlich transitiv toter Skripte."""
        # Am Ort neu angelegte Dateien wie AGENTS.md sind trotz Archivierung erreichbar.
        archived = {r['pfad'] for r in rows if self.target(r) != r['pfad'] and not (root / r['pfad']).exists()}
        code = [r['pfad'] for r in rows if r['klasse'] == 'Code']
        texts = {}
        for name in code:
            path = root / name
            if path.is_symlink() or secret_path(name) or not path.is_file():
                continue
            try:
                texts[name] = path.read_bytes().decode('utf-8')
            except UnicodeDecodeError:
                continue  # Binärdateien enthalten keine statisch lesbaren Befehle.
        patterns = {}
        def hits(text, name):
            if name not in patterns:
                variants = {value for archived_path in archived for value in
                            (archived_path, os.path.relpath(archived_path, str(Path(name).parent)),
                             str(self.root / archived_path))}
                patterns[name] = [re.compile(r'(?<![\w./-])(?:\./)?' + re.escape(value) + r'(?![\w./-])')
                                  for value in variants]
            return any(pattern.search(text) for pattern in patterns[name])
        def calls(text):
            return re.findall(r"\bnpm\s+(?:(?:--[\w-]+|-[a-zA-Z]+)\s+)*(?:run|run-script)\s+"
                              r"(?:(?:--[\w-]+|-[a-zA-Z]+)\s+)*['\"]?([\w:.-]+)", text)
        packages = {}
        for name, text in texts.items():
            if Path(name).name != 'package.json':
                continue
            current = json.loads(text).get('scripts', {})
            original = json.loads(self.original_bytes(name)).get('scripts', {})
            dead = {key for key, value in original.items() if hits(value, name)}
            # Auch Wrapper im Original werden durch die Archivierung unbrauchbar.
            while True:
                more = {key for key, value in original.items()
                        if set(calls(value)) & dead or 'pre' + key in dead or 'post' + key in dead}
                if more <= dead:
                    break
                dead |= more
            # Ein ersetzter, nun lebender Befehl ist kein toter Verweis.
            broken = {key for key in dead if key not in current or hits(current[key], name)}
            while True:
                more = {key for key, value in current.items()
                        if set(calls(value)) & broken or
                        any(hook in current and hook in broken for hook in ('pre' + key, 'post' + key))}
                if more <= broken:
                    break
                broken |= more
            packages[Path(name).parent] = broken
        findings = []
        for name, text in texts.items():
            parent = Path(name).parent
            candidates = [p for p in packages if parent == p or p in parent.parents]
            dead = packages[max(candidates, key=lambda p: len(p.parts))] if candidates else set()
            for number, line in enumerate(text.splitlines(), 1):
                if f'{name}:{number}' not in allowed and (hits(line, name) or set(calls(line)) & dead):
                    findings.append(f'{name}:{number}: {line.strip()}')
        require(not findings, 'U-15: Verweise auf archivierte Pfade/tote npm-Befehle: ' + '; '.join(findings))
        return True

    def valid_inventory(self):
        folder = self.folder / 'inventar'
        require(not folder.is_symlink(), 'Inventar darf kein Symlink sein.')
        for path in sorted(folder.rglob('*')):
            require(not path.is_symlink(), 'Inventar darf kein Symlink sein: ' + str(path))
            if path.is_file():
                require(path.suffix == '.json' and not secret_path(path.name),
                        'Inventar benötigt JSON ohne Geheimnis-Pfad: ' + str(path))
                try:
                    json.loads(read(path))
                except ValueError as exc:
                    raise Fehler('Ungültiges Inventar-JSON ' + str(path) + ': ' + str(exc))
        return True

    def old_decisions(self, rows):
        decisions, unknown = [], []
        for row in rows:
            path = row['pfad']
            if Path(path).name.casefold() not in ('decisions.json', 'decisions.md'):
                continue
            original = self.root / self.target(row)
            if not original.exists() and not original.is_symlink():
                original = self.root / path
            if original.is_symlink() and row['klasse'] == 'Governance alt':
                # Alte Governance-Aliasdateien sind keine zweite Entscheidungssammlung.
                # Nur Link-Metadaten lesen; der eigenständig inventarisierte Text zählt einmal.
                link = Path(os.readlink(original))
                alias = os.path.normpath(str(Path(path).parent / link))
                canonical = next((r for r in rows if r['pfad'] == alias), None)
                if (not link.is_absolute() and canonical and not secret_path(alias) and
                        self.file_mode(self.root / self.target(canonical)) != '120000' and
                        self.file_mode(self.root / alias) != '120000' and
                        Path(alias).name.casefold() in ('decisions.md', 'decisions.json')):
                    continue
            if original.is_symlink() or secret_path(path):
                unknown.append(path)
                continue
            text = read(original)
            if path.lower().endswith('.json'):
                data = json.loads(text)
                entries = data.get('decisions', data.get('entscheidungen')) if isinstance(data, dict) else data
                if isinstance(entries, dict):
                    entries = list(entries.values())
                if not isinstance(entries, list):
                    unknown.append(path)
                    continue
                decisions += [path + '#' + str(i + 1) for i in range(len(entries))]
            else:
                headings = [(i, s) for i, s in enumerate(text.splitlines(), 1)
                            if re.match(r'^#{2,3}\s+(?:E[- ]?\d+|\d{4}-\d{2}-\d{2}|Entscheidung\b)', s)]
                lines = text.splitlines()
                if not headings and not any(s.startswith('##') for s in lines):
                    # Zeilenformat: jede Textzeile zählt. Zu viel blockiert, verloren geht nichts.
                    headings = [(i, s) for i, s in enumerate(lines, 1) if s.strip() and not s.startswith('#')]
                if not headings and text.strip():
                    unknown.append(path)
                decisions += [path + ':' + str(i) for i, _ in headings]
        return decisions, unknown

    def neutralize(self):
        saved = self.folder / 'hooks'
        saved.mkdir(parents=True, exist_ok=True)
        old = self.git('config', '--get', 'core.hooksPath', check=False, gates=True).stdout.strip()
        # Auch geerbte Hooks werden nur lokal deaktiviert; fremde Verzeichnisse bleiben erhalten.
        common = (self.root / self.output('rev-parse', '--git-common-dir')).resolve()
        locations = [('git-hooks', common / 'hooks')]
        if old and old != '/dev/null':
            locations.append(('hooksPath', (self.root / old).resolve()))
        for label, directory in locations:
            if directory.is_dir():
                for p in directory.iterdir():
                    if p.is_file() and not p.is_symlink() and not secret_path(p.name):
                        dest = saved / label / p.name
                        dest.parent.mkdir(parents=True, exist_ok=True)
                        if not dest.exists():
                            shutil.copy2(p, dest)
                        if label == 'git-hooks' and os.access(p, os.X_OK) and not p.name.endswith('.sample'):
                            p.chmod(p.stat().st_mode & ~0o111)
        if not (saved / 'config.json').exists():
            json_write(saved / 'config.json', {'core.hooksPath': old, 'lokal':
                self.git('config', '--local', '--get', 'core.hooksPath', check=False, gates=True).stdout.strip() or None})
        self.git('config', '--local', 'core.hooksPath', '/dev/null')
        for name in ('.claude/settings.json', '.codex/hooks.json'):
            path = self.root / name
            if path.is_file():
                require(not path.is_symlink(), 'Hook-Einstellungen dürfen kein Symlink sein.')
                original = json.loads(read(path))
                cleaned = self.without_old_hooks(original)
                if cleaned != original:
                    dest = self.folder / 'originale' / name
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    if not dest.exists():
                        shutil.copy2(path, dest)
                    json_write(path, cleaned)

    def repair_links(self, rows, knowledge=False):
        moved = {r['pfad']: self.target(r) for r in rows if self.target(r) != r['pfad']}
        sources = rows if not knowledge else [{'pfad': p, 'klasse': 'Fachdoku'} for p in ('START.md', 'vision.md')]
        for row in sources:
            if row['klasse'] != 'Fachdoku' or not row['pfad'].endswith('.md'):
                continue
            path = self.safe(row['pfad'])
            require(not path.is_symlink(), 'Fachdoku-Symlink wird nicht bearbeitet.')
            text = read(path)
            def replace(match):
                dest = match[2]
                bare, sep, anchor = dest.partition('#')
                resolved = os.path.normpath(str(Path(row['pfad']).parent / unquote(bare)))
                if resolved not in moved:
                    return match[0]
                target = os.path.relpath(moved[resolved], Path(row['pfad']).parent).replace(' ', '%20')
                return match[1] + target + (sep + anchor if sep else '') + match[3]
            new = re.sub(r'(\]\(<?)([^\s)>]+)(>?\))', replace, text)
            new = re.sub(r'(?m)^(\[[^\]]+\]:\s*<?)([^\s>]+)(>?)', replace, new)
            if new != text:
                # U-07: Auch bei reparierten Links bleibt das ursprüngliche Bytebild erhalten.
                dest = self.folder / 'originale' / row['pfad']
                if not dest.exists():
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(path, dest)
                atomic(path, new)

    def apply(self):
        rows = self.mapping()
        self.config()
        state = self.document('zustand.json')
        require(state['phase'] == 'gestartet', 'apply ist nur einmal pro Umbau erlaubt.')
        require(self.git('diff', '--name-only', state['tag'], '--', *state['dateien']).stdout == '',
                'Ausgangsdateien wurden vor apply geändert; zuerst zuordnen und sichern.')
        decisions, unknown = self.old_decisions(rows)
        require(not unknown, 'U-11: Entscheidungsformat unbekannt; Inventar mit eindeutigen Quellen nötig: ' + ', '.join(unknown))
        # Zielkonflikte vor dem ersten mv prüfen; alte Schreibweisen immer zuerst wegnehmen.
        for row in rows:
            if self.target(row) != row['pfad']:
                require(not self.safe(self.target(row)).exists(), 'Archivziel existiert: ' + self.target(row))
        for name in ('START.md', 'vision.md'):
            source = self.folder / 'wissen' / name
            require(source.is_file() and not source.is_symlink(), 'Neue Wissensdatei fehlt: ' + name)
            existing = next((r for r in rows if r['pfad'].casefold() == name.casefold()), None)
            require(not existing or existing['klasse'] == 'Wissen alt', 'Wissensziel muss als Wissen alt archiviert werden: ' + name)
        for name in ('AGENTS.md', 'CLAUDE.md'):
            existing = next((r for r in rows if r['pfad'].casefold() == name.casefold()), None)
            require(not existing or existing['klasse'] in ('Wissen alt', 'Governance alt'), 'Kit-Verweis benötigt archiviertes Original: ' + name)
        require(isinstance(self.document('bestand.json'), dict), 'Bestandsimport fehlt.')
        for row in rows:
            if row['klasse'] == 'Code' and row['pfad'] in ('.gitignore', '.gov/config.json'):
                require(row['pfad'] == '.gitignore' and '.worktrees/' in read(self.root / row['pfad']).splitlines(),
                        'Klasse Code darf nicht für Kit-Konfiguration verändert werden: ' + row['pfad'])
        for row in rows:
            if row['klasse'] == 'Code' and row['pfad'] in ('.claude/settings.json', '.codex/hooks.json'):
                data = json.loads(read(self.root / row['pfad']))
                require(self.without_old_hooks(data) == data, 'Code-Klasse enthält alte Hook-Konfiguration; zuerst einordnen.')
        changes = self.reference_changes(rows)  # vollständig prüfen, bevor Dateien verschoben werden
        self.neutralize()
        for path, content in changes.items():
            original = self.folder / 'originale' / path
            original.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(self.root / path, original)
            (self.root / path).write_bytes(content)
        for row in sorted(rows, key=lambda r: len(Path(r['pfad']).parts), reverse=True):
            target = self.target(row)
            if target != row['pfad']:
                self.safe(target).parent.mkdir(parents=True, exist_ok=True)
                self.git('mv', '--', row['pfad'], target)
        self.repair_links(rows)
        for name in ('START.md', 'vision.md'):
            shutil.copy2(self.folder / 'wissen' / name, self.root / name)
        self.repair_links(rows, knowledge=True)
        hints = self.folder / 'wissen/hinweise.md'
        require(not hints.is_symlink(), 'Hinweise dürfen kein Symlink sein.')
        for adapter, name in (('claude', 'CLAUDE.md'), ('codex', 'AGENTS.md')):
            atomic(self.root / name, read(self.kit / adapter / name.replace('.md', '.snippet.md')) +
                   ('\n\n' + read(hints) if hints.exists() else ''))
        # Gates bleiben aus. Diese Konfiguration wird erst im finish durch init installiert.
        (self.root / '.gov').mkdir(exist_ok=True)
        cfg = self.config()
        json_write(self.root / '.gov/config.json', {'main_branch': state['main'], 'test_cmd': cfg['test_cmd'], 'tests_dir': cfg['tests_dir']})
        handoff = []
        if globally_installed():
            # Der globale Router sieht ab hier .gov. Die Pending-Rolle umbau muss
            # schon zwischen apply und finish an den lokalen Hook weiterreichen können.
            hook = self.root / '.gov/govhook'
            ownership = self.root / '.gov/claude-files.json'
            require(not hook.exists() and not hook.is_symlink() and not ownership.exists() and not ownership.is_symlink(),
                    'Alte .gov-Hook-Dateien zuerst als Governance alt zuordnen.')
            atomic(hook, read(self.kit / 'govhook'))
            hook.chmod(0o755)
            json_write(ownership, {'.gov/govhook': hashlib.sha256(hook.read_bytes()).hexdigest()})
            handoff = ['.gov/govhook', '.gov/claude-files.json']
        for name in ('features', 'decisions', 'journal', MIGRATION_ARCHIVE):
            (self.root / name).mkdir(parents=True, exist_ok=True)
        ignore = self.root / '.gitignore'
        if ignore.exists():
            original = self.folder / 'originale/.gitignore'
            original.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(ignore, original)
        old = read(ignore) if ignore.exists() else ''
        if '.worktrees/' not in old.splitlines():
            atomic(ignore, old + ('\n' if old and not old.endswith('\n') else '') + '.worktrees/\n')
        state.update(phase='angewendet', entscheidungen=decisions)
        json_write(self.folder / 'zustand.json', state)
        self.git('add', '--', 'START.md', 'vision.md', 'AGENTS.md', 'CLAUDE.md', '.gov/config.json', '.gitignore', *handoff)
        self.commit('Umbau: Wissen und Automatik umgezogen')
        print('Umzug angewendet; Gates bleiben bis finish inaktiv.')

    def fingerprint(self):
        # Prüf-/Review-Dateien sind Ausgaben; sämtliche übrigen Eingaben binden die Freigabe.
        paths = sorted(set(self.tracked()) | {p for p in self.files() if p.startswith('_umbau/')})
        state = self.document('zustand.json')
        hashes = [('tag', self.output('rev-parse', state['tag'])),
                  ('hooksPath', self.git('config', '--get', 'core.hooksPath', check=False, gates=True).stdout)]
        for path in paths:
            if secret_path(path):
                hashes.append((path, 'nicht gelesen'))
                continue
            if path.startswith(('_umbau/berichte/', '_umbau/kit-fehler')) or path in ('_umbau/check.json', '_umbau/pruefung.json', '_umbau/testergebnis.json'):
                continue
            hashes.append((path, self.digest(self.root / path), self.file_mode(self.root / path)))
        return hashlib.sha256(json.dumps(hashes, ensure_ascii=False).encode()).hexdigest()

    @staticmethod
    def file_mode(path):
        if path.is_symlink():
            return '120000'
        if not path.is_file():
            return None
        return '100755' if path.stat().st_mode & 0o111 else '100644'

    @staticmethod
    def digest(path):
        if secret_path(str(path)):
            return 'nicht gelesen'
        if path.is_symlink():
            data = os.readlink(path).encode()
        elif path.is_file():
            data = path.read_bytes()
        else:
            return None
        return hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest()

    def finish_steps(self):
        state, cfg = self.document('zustand.json'), self.config()
        # Vorhandene Konfiguration bleibt belegbar, auch wenn init Hooks ergänzt.
        for path in ('.claude/settings.json', '.codex/config.toml', '.codex/hooks.json'):
            p = self.root / path
            if p.is_file():
                dest = self.folder / 'originale' / path
                if not dest.exists():
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(p, dest)
        with working_directory(self.root):
            initialize(argparse.Namespace(test_cmd=cfg['test_cmd'], no_github=True))
            gov = Gov()
            with gov.locked():
                data = self.document('bestand.json')
                gov.import_bestand(data)
                # B5/offene Pläne sind Ideen, keine erfundenen fertigen Features.
                for text in cfg.get('offen', []):
                    gov.idea('Offener Punkt', text)
                gov.state['bestand_offen'] = False
                # Leiter-Festlegung F1: ausschließlich Abschluss des Umbaus,
                # keine erfundene Nutzerbestätigung. candidate prüft dies im Klon.
                gov.state['vision'] = {'tragfaehig': True, 'quelle': 'Umbau'}
                gov.save()
        report = self.folder / 'bericht.md'
        notice = 'Vision tragfähig; Quelle: Umbau. Ohne Nutzerbestätigung durch gov migrate finish.'
        if notice not in read(report):
            atomic(report, read(report) + '\n' + notice + '\n')
        destination = self.root / MIGRATION_ARCHIVE / ('umbau-' + state['datum'])
        require(not destination.exists(), 'Umbau-Archivziel existiert bereits.')
        destination.parent.mkdir(parents=True, exist_ok=True)
        self.git('add', '--', '_umbau')
        self.git('mv', '--', '_umbau', str(destination.relative_to(self.root)))
        json_write(self.root / '.gov/migration.json', {'abgeschlossen': True, 'tag': state['tag'], 'main': state['main'],
                                                     'archiv': str(destination.relative_to(self.root))})
        with working_directory(self.root):
            gov = Gov()
            with gov.locked():
                # Nur der interne migrate-Token darf diesen abgeschlossenen Archivstand schreiben.
                paths = ['.gov/migration.json', str(destination.relative_to(self.root))]
                with gov.token(gov.root, 'gov', operation='migrate', main=True) as env:
                    gov.git('add', '-A', '--', *paths)
                    gov.git('commit', '-m', 'Umbau abgeschlossen', env=env)
        return destination

    @contextlib.contextmanager
    def candidate(self):
        state = self.document('zustand.json')
        with self.tag_copy('gov/umbau') as root:
            # Klon + Arbeitsstand: auch uncommittete Schäden müssen den Check rot machen.
            indexed = set(self.tracked())
            for path in indexed | {p for p in self.files() if p.startswith('_umbau/')}:
                if secret_path(path):
                    continue
                src, dest = self.safe(path), root / path
                if src.is_symlink():
                    if dest.exists() or dest.is_symlink():
                        dest.unlink()
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    dest.symlink_to(os.readlink(src))
                elif src.is_file():
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(src, dest)
                elif dest.exists():
                    dest.unlink()  # Ausschließlich Wegwerf-Kopie, bildet absichtliche Testschäden ab.
            self.git('checkout', '-B', state['main'], cwd=root)
            self.git('add', '-A', cwd=root)
            self.git('commit', '--allow-empty', '-m', 'Umbau-Prüfstand', cwd=root)
            instance = Migrate(root)
            archive = instance.finish_steps()
            yield instance, archive

    @staticmethod
    def contains_settings(old, new):
        if isinstance(old, dict):
            return isinstance(new, dict) and all(k in new and Migrate.contains_settings(v, new[k]) for k, v in old.items())
        if isinstance(old, list):
            return isinstance(new, list) and all(x in new for x in old)
        return old == new

