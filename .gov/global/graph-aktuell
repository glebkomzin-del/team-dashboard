#!/usr/bin/env python3
"""Stiller SessionStart: Code-Graph bei Bedarf im Hintergrund aktualisieren."""
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def main():
    if len(sys.argv) > 1 and sys.argv[1] == '--run':
        # Der geerbte Deskriptor hält die Sperre bis zum Ende des Updates.
        subprocess.run([sys.argv[3], 'update', '.'], cwd=sys.argv[2], check=False)
        return
    cwd = (sys.argv[2] if len(sys.argv) == 3 and sys.argv[1] == '--cwd'
           else json.load(sys.stdin).get('cwd', os.getcwd()) if not sys.stdin.isatty()
           else os.getcwd())
    exe = shutil.which('graphify')
    if not exe or Path(cwd).resolve() == Path.home().resolve():
        return
    env = os.environ.copy()
    for key in ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_COMMON_DIR', 'GIT_PREFIX'):
        env.pop(key, None)

    def git(*args):
        return subprocess.check_output(['git', '-C', str(cwd), *args], env=env,
                                       stderr=subprocess.DEVNULL, text=True, timeout=2).strip()

    root = Path(git('rev-parse', '--show-toplevel')).resolve()
    if root == Path.home().resolve():
        return
    common = (Path(cwd) / git('rev-parse', '--git-common-dir')).resolve()
    with (common / 'graph-aktuell.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        exclude = common / 'info/exclude'
        exclude.parent.mkdir(parents=True, exist_ok=True)
        old = exclude.read_text() if exclude.exists() else ''
        if 'graphify-out/' not in old.splitlines():
            with exclude.open('a') as stream:
                stream.write(('\n' if old and not old.endswith('\n') else '') + 'graphify-out/\n')
        graph = root / 'graphify-out/graph.json'
        if graph.exists() and graph.stat().st_mtime >= int(git('log', '-1', '--format=%ct')):
            return
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '--run', str(root), exe],
                         env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, pass_fds=(lock.fileno(),))


if __name__ == '__main__':
    try:
        main()
    except Exception:
        pass  # Orientierung darf weder Session noch Merge verhindern.
