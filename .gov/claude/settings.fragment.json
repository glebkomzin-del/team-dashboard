{
  "hooks": {
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.gov/govhook claude UserPromptExpansion"
          }
        ],
        "matcher": "vision|build|migrate"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.gov/govhook claude PreToolUse",
            "onFailure": "block"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.gov/govhook claude UserPromptSubmit"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.gov/govhook claude SubagentStop",
            "timeout": 1800
          }
        ],
        "matcher": "worker"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.gov/govhook claude Stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.gov/govhook claude SessionStart"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.gov/gov *)",
      "Bash(python3 .gov/gov *)",
      "Bash(git *)",
      "Bash({{TEST_COMMAND}})"
    ],
    "defaultMode": "acceptEdits"
  }
}
